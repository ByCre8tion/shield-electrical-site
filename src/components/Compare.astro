---
/* Before and after with a draggable divider. Image Compare pattern (21st.dev), rebuilt.
   A native range input drives it, so arrows, touch and screen readers work. */
import Photo from './Photo.astro';
interface Props { before: string; after: string; label: string; ratio?: string }
const { before, after, label, ratio = '16 / 9' } = Astro.props;
---
<div class="cmp" data-compare style={`aspect-ratio:${ratio}`}>
  <div class="cmp-layer"><Photo k={before} ratio={ratio} label={`${label}, before`} /></div>
  <div class="cmp-layer cmp-after"><Photo k={after} ratio={ratio} label={`${label}, after`} /></div>
  <span class="cmp-tag cmp-tag-b">Before</span><span class="cmp-tag cmp-tag-a">After</span>
  <span class="cmp-handle" aria-hidden="true"></span>
  <span class="cmp-note">Add photos/{before}.jpg and {after}.jpg</span>
  <input type="range" min="0" max="100" value="50" step="1" aria-label={`Compare ${label} before and after`} />
</div>
<style is:global>
.cmp{--pos:50%;position:relative;overflow:hidden;border-radius:var(--r-panel);border:1px solid var(--seam)}
.cmp-layer{position:absolute;inset:0}
.cmp-layer .photo{height:100%;border-radius:0}
.cmp-after{clip-path:inset(0 0 0 var(--pos))}
.cmp-after .photo.ph{background-color:var(--deck-2)}
.cmp-handle{position:absolute;top:0;bottom:0;left:var(--pos);width:2px;translate:-1px 0;background:var(--gold);pointer-events:none}
.cmp-handle::after{content:"";position:absolute;top:50%;left:50%;width:40px;height:40px;translate:-50% -50%;border-radius:50%;border:1px solid #A88A1E;background:linear-gradient(180deg,#F7DD7A,#D9B53A);box-shadow:inset 0 1px 0 rgba(255,248,226,.75),0 8px 20px -8px rgba(0,0,0,.8)}
.cmp input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:ew-resize}
.cmp input:focus-visible+*,.cmp:has(input:focus-visible){outline:2px solid var(--gold-hi);outline-offset:3px}
.cmp .ph-cap{display:none}
.cmp-note{position:absolute;left:50%;bottom:22px;translate:-50% 0;padding:6px 12px;border-radius:var(--r-pill);background:rgba(10,10,11,.8);font-size:.75rem;color:var(--ink-3);pointer-events:none;white-space:nowrap}
.cmp-tag{position:absolute;top:24px;padding:6px 12px;border-radius:var(--r-pill);background:rgba(10,10,11,.8);font:500 .75rem/1 var(--mono);color:var(--ink-2);pointer-events:none}
.cmp-tag-b{left:28px}.cmp-tag-a{right:28px}
</style>
