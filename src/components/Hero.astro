---
/* Hero v3: edge to edge, no card. A wireframe city drawn in code where current travels the streets
   and powers a building (src/scripts/city.js). Copy left, HUD readouts in the corners. */
import Icon from './Icon.astro';
import icons from '../data/icons.json';
import reviews from '../data/reviews.json';
import { company } from '../data/site';
const ic = icons as Record<string, string>;
const people = reviews.reviews.slice(0, 4).map((r: { author: string }) => r.author.split(/\s+/).map((p) => p[0]).join('').slice(0, 2));
const sources = [{ k: 'google', l: 'Google' }, { k: 'facebook', l: 'Facebook' }];
---
<section class="hero gridbg" aria-labelledby="hero-h">
  <canvas class="hero-cv" data-city aria-hidden="true"></canvas>
  <div class="hero-fade" aria-hidden="true"></div>

  <div class="wrap hero-in">
    <div class="hero-copy">
      <p class="hero-lic" data-on>Licensed electrical contractor serving Scottsdale, AZ</p>
      <h1 id="hero-h" class="t-display" data-on>Power you can trust, <span class="hl">wired right.</span></h1>
      <p class="lead" data-on>Homes and businesses across the Valley. Written price before any work starts.</p>
      <div class="btn-row" data-on>
        <a class="btn btn-gold" href="/contact/">Book service <Icon name="arrow-right" size={18} class="ico-go" /></a>
        <a class="btn btn-line hero-call" href={`tel:${company.tel}`}><Icon name="phone" size={18} />Call <span class="val">{company.phone}</span></a>
      </div>
      <a class="trustrow" href="#reviews" data-on>
        <span class="faces" aria-hidden="true">{people.map((p: string, i: number) => <span class="ph" data-slot={`face${i + 1}`} data-alt=""><span class="ph-cap">{p}</span></span>)}</span>
        <span class="tr-t"><b><span class="val">{reviews.rating.toFixed(1)}</span> from Valley customers</b><span>{reviews.total} reviews</span></span>
        <span class="tr-src">{sources.map((s) => <svg viewBox="0 0 24 24" role="img" aria-label={s.l}><path d={ic[s.k]} fill="currentColor" /></svg>)}</span>
      </a>
    </div>
  </div>

  <div class="hero-hud wrap" aria-hidden="true">
    <div class="hud hh-l"><span>33.4942° N &nbsp;111.9261° W</span><span><b>Scottsdale, Arizona</b></span></div>
  </div>
</section>
<style is:global>
.hero{position:relative;overflow:hidden;margin-top:-72px;min-height:min(86svh,820px);display:flex;flex-direction:column;justify-content:center;padding-block:136px 112px}
.hero-cv{position:absolute;inset:0;width:100%;height:100%}
.hero-fade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,var(--night) 0%,rgba(10,10,11,.86) 30%,rgba(10,10,11,0) 58%),linear-gradient(0deg,var(--night) 0%,rgba(10,10,11,0) 22%)}
.hero-in{position:relative;width:100%;pointer-events:none}
.hero-copy{display:flex;flex-direction:column;align-items:flex-start;gap:26px;max-width:640px}
.hero-lic{font-size:.9375rem;color:var(--ink-2);margin-bottom:-4px}
.hero-copy>*{pointer-events:auto}
.hero-copy h1{max-width:12ch}
.trustrow{display:flex;align-items:center;gap:14px;margin-top:6px;border-radius:14px}
.faces{display:flex}
.faces>span{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;margin-left:-10px;border:2px solid var(--night);background:#2a2b2e;font:500 .6875rem/1 var(--display);color:var(--ink)}
.faces>span:first-child{margin-left:0}
.faces>span{position:relative;overflow:hidden}
.faces .ph-cap{display:contents;padding:0}
.faces img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
/* Edit mode: grow the faces so each one can take a photo */
.editing .faces{gap:8px}.editing .faces>span{width:112px;height:112px;margin-left:0;overflow:visible;border-radius:16px}
.editing .faces img{border-radius:16px}
.editing .faces .ed-slot .ed-btn{min-height:30px;padding:0 10px;font-size:.75rem}
.editing .faces .ed-name{font-size:.5625rem}
.faces>span:nth-child(2){background:#3a3b3e}.faces>span:nth-child(3){background:#232426}.faces>span:nth-child(4){background:#47484c}
.tr-t{display:flex;flex-direction:column;line-height:1.3}
.tr-t b{font-weight:500;font-size:.875rem;color:var(--ink)}
.tr-t>span{font-size:.8125rem;color:var(--ink-3)}
.tr-src{display:flex;gap:8px;padding-left:14px;border-left:1px solid var(--seam);color:var(--ink-2)}
.tr-src svg{width:16px;height:16px}
@media (hover:hover){.trustrow:hover b{color:var(--volt-hi)}}
.hero-hud{position:absolute;left:0;right:0;bottom:28px;display:flex;justify-content:space-between;gap:24px;pointer-events:none}
.hero-hud>div{display:flex;flex-direction:column;gap:6px}
.hero-tr{position:absolute;left:0;right:0;top:104px;display:flex;justify-content:flex-end;pointer-events:none}
.hh-r{display:flex;flex-direction:column;gap:6px;text-align:right}
.hh-r .ok{color:var(--live)}
.hero-hud .ok{color:var(--live)}
@media (max-width:1100px){
  .hero{min-height:0;justify-content:flex-start;padding-block:128px 0}
  .hero-cv{position:relative;inset:auto;height:clamp(380px,62vw,620px);margin-top:8px;order:2}
  .hero-fade{background:linear-gradient(180deg,var(--night) 0%,rgba(10,10,11,0) 45%),linear-gradient(0deg,var(--night) 0%,rgba(10,10,11,0) 18%)}
  .hero-hud,.hero-tr{display:none}
}
@media (max-width:640px){.hero-call{display:none}.tr-src{display:none}}
</style>
