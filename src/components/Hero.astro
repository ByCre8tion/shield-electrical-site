---
import Circuit from './Circuit.astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { company } from '../data/site';
---
<section class="hero" aria-labelledby="hero-h">
  <Circuit />
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 id="hero-h" class="t-display" data-on>Power you can trust, <span class="hl">wired right.</span></h1>
      <p class="lead" data-on>Licensed electricians for homes and businesses across the Valley. Written price before any work starts.</p>
      <div class="btn-row" data-on>
        <a class="btn btn-gold" href="/contact/">Book service <Icon name="arrow-right" size={18} class="ico-go" /></a>
        <a class="btn btn-line hero-call" href={`tel:${company.tel}`}><Icon name="phone" size={18} />Call <span class="val">{company.phone}</span></a>
      </div>
    </div>
    <div class="hero-visual" data-on>
      <Photo k="hero" ratio="5 / 6" eager sizes="(max-width: 900px) 100vw, 42vw" />
      <div class="hero-meter panel">
        <span class="hm-k">Typical panel upgrade</span>
        <span class="hm-v"><span class="val">100A</span><Icon name="arrow-right" size={14} /><span class="val hm-gold">200A</span></span>
        <span class="hm-k">Power back the same afternoon</span>
      </div>
    </div>
  </div>
</section>
<style is:global>
.hero{position:relative;overflow:hidden;margin-top:-76px;padding-top:76px}
.hero::before{content:"";position:absolute;right:-10%;top:10%;width:60%;height:80%;background:radial-gradient(closest-side,rgba(216,183,118,.14),transparent);pointer-events:none}
.hero-grid{position:relative;display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:clamp(32px,5vw,80px);align-items:center;padding-block:clamp(48px,7vw,96px) clamp(56px,7vw,104px)}
.hero-copy{display:flex;flex-direction:column;gap:28px;pointer-events:none}
.hero-copy>*{pointer-events:auto}
.hero-copy h1{max-width:13ch}
.hero-visual{position:relative}
.hero-meter{position:absolute;left:-28px;bottom:28px;display:flex;flex-direction:column;gap:6px;padding:16px 20px;background:rgba(17,20,25,.86);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
.hm-k{font-size:.8125rem;color:var(--ink-2)}
.hm-v{display:flex;align-items:center;gap:10px;font-size:1.5rem;color:var(--ink-3)}
.hm-v .val{font-size:1.5rem;color:var(--ink)}
.hm-v .hm-gold{color:var(--gold-hi)}
@media (max-width:900px){.hero-grid{grid-template-columns:minmax(0,1fr)}.hero-visual .photo{aspect-ratio:4/3!important}.hero-meter{left:16px;bottom:16px}}
@media (max-width:760px){.hero-call{display:none}}
</style>
