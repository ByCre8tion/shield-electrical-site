---
import data from '../data/reviews.json';
const reviews = data.reviews;
const half = Math.ceil(reviews.length / 2);
const rows = [reviews.slice(0, half), reviews.slice(half)];
const G = '<svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>';
const star = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m10 1.8 2.5 5.3 5.8.7-4.3 4 1.1 5.7L10 14.7l-5.1 2.8L6 11.8l-4.3-4 5.8-.7z" fill="currentColor"/></svg>';
---
<section class="reviews sec panel-mode" id="reviews" aria-labelledby="rev-h">
  <div class="wrap rv-head" data-reveal>
    <div>
      <p class="readout">{Astro.props.n || '05'} / <b>Reviews</b></p>
      <h2 id="rev-h" class="t-h2" style="margin-top:20px">What customers <span class="hl">say</span></h2>
    </div>
    <a class="rv-score" href={data.url} target="_blank" rel="noopener">
      <span class="g-badge" set:html={G} />
      <span class="rv-num">{data.rating.toFixed(1)}</span>
      <span class="rv-meta">
        <span class="stars" set:html={star.repeat(5)} />
        <span>{data.total} reviews on Google<span class="sr-only"> (opens in a new tab)</span> <span class="arr" aria-hidden="true">→</span></span>
      </span>
    </a>
  </div>
  {data.placeholder && <p class="wrap rv-note">Placeholder: these are {data.placeholder} reviews from Google, shown until the Shield Electrical profile is connected.</p>}
  <div class="rv-rows" id="rvRows" data-rv-rows role="region" aria-label="Google reviews" tabindex="0">
    {rows.map((row, r) => (
      <div class:list={['rv-row', { rev: r === 1 }]} data-reveal>
        <ul class="rv-track">
          {[0, 1].map((copy) => row.map((v) => (
            <li class="rv-card" aria-hidden={copy === 1 ? 'true' : undefined}>
              <div class="rv-top">
                <span class="rv-av" aria-hidden="true">{v.author.trim().charAt(0)}</span>
                <span class="rv-who"><b>{v.author}</b><span>{v.when}</span></span>
                <span class="g-mark" set:html={G} title="Posted on Google" />
              </div>
              <div class="rv-rate" role="img" aria-label={`${v.rating} out of 5 stars, verified Google review`}>
                <span class="stars" set:html={star.repeat(v.rating)} />
                <svg class="rv-check" viewBox="0 0 16 16" aria-hidden="true"><path d="m3 8.5 3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <p>{v.text}</p>
            </li>
          )))}
        </ul>
      </div>
    ))}
  </div>
  <div class="wrap rv-foot">
    <button type="button" class="mq-toggle" id="rvToggle" data-rv-toggle aria-pressed="false">Pause</button>
    <a class="link" href={data.url} target="_blank" rel="noopener">Read every review on Google<span class="sr-only"> (opens in a new tab)</span> <span class="arr" aria-hidden="true">→</span></a>
  </div>
</section>
<style is:global>
.reviews{--white:var(--switch);--ink:var(--volt);--ink-2:var(--steel);--muted:var(--steel);--ember:var(--brass-lt);--r-photo:4px}
.reviews{overflow:hidden}
.rv-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:28px;margin-bottom:20px}
.rv-score{display:grid;grid-template-columns:auto auto auto;align-items:center;gap:16px;padding:16px 22px 16px 18px;border:1px solid var(--rule);border-radius:var(--r-photo);background:var(--white);transition:border-color .25s ease-out}
@media (hover:hover){ .rv-score:hover{border-color:var(--rule-strong)} .rv-score:hover .arr{transform:translateX(4px)} }
.g-badge svg{width:34px;height:34px;display:block}
.rv-num{font-family:var(--display);font-weight:700;font-size:3.25rem;line-height:.9;font-variant-numeric:tabular-nums}
.rv-meta{display:flex;flex-direction:column;gap:6px;font-size:0.875rem;font-weight:500;color:var(--ink-2)}
.rv-meta .stars{display:flex;gap:2px;color:#F4B400}
.rv-meta .stars svg{width:16px;height:16px}
.rv-note{font-size:0.8125rem;color:var(--muted);margin-bottom:clamp(32px,4vw,56px)}
.rv-rows{display:flex;flex-direction:column;gap:16px;-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
.rv-row{overflow:hidden}
.rv-track{display:flex;gap:16px;width:max-content;margin:0;padding:0;list-style:none;animation:rv-slide var(--rv-dur,70s) linear infinite}
.rv-row.rev .rv-track{animation-direction:reverse;--rv-dur:80s}
.rv-rows.paused .rv-track{animation-play-state:paused}
@keyframes rv-slide{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 8px))}}
.rv-card{width:clamp(300px,30vw,400px);flex:none;display:flex;flex-direction:column;gap:16px;padding:24px;background:var(--white);border:1px solid var(--rule);border-radius:var(--r-photo);transition:border-color .25s ease-out}
@media (hover:hover){ .rv-card:hover{border-color:var(--rule-strong)} }
.rv-top{display:grid;grid-template-columns:44px minmax(0,1fr) 24px;align-items:center;gap:14px}
.rv-av{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:var(--white);font-family:var(--display);font-weight:700;font-size:1.25rem}
.rv-card:nth-child(3n+2) .rv-av{background:var(--ember)}
.rv-card:nth-child(3n+3) .rv-av{background:#5B6164}
.rv-who{display:flex;flex-direction:column;min-width:0;line-height:1.3}
.rv-who b{font-weight:600}
.rv-who span{font-size:0.8125rem;color:var(--muted)}
.g-mark svg{width:24px;height:24px;display:block}
.rv-rate{display:flex;align-items:center;gap:8px}
.rv-rate .stars{display:flex;gap:2px;color:#F4B400}
.rv-rate .stars svg{width:18px;height:18px}
.rv-check{width:16px;height:16px;color:#1A73E8}
.rv-card p{color:var(--ink-2);font-size:0.9375rem;line-height:1.6}
.rv-foot{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;margin-top:clamp(28px,3vw,44px)}
.mq-toggle{height:40px;padding:0 16px;border-radius:2px;border:1px solid var(--rule-strong);font-size:0.8125rem;font-weight:600;color:var(--ink)}
@media (prefers-reduced-motion: reduce){
  .rv-track{animation:none}
  .rv-row{overflow-x:auto;scroll-snap-type:x mandatory;padding-inline:var(--gut)}
  .rv-card{scroll-snap-align:start}
  .rv-card[aria-hidden="true"]{display:none}
  .rv-rows{-webkit-mask-image:none;mask-image:none}
  #rvToggle{display:none}
}
@media (max-width:640px){ .rv-score{grid-template-columns:auto auto;row-gap:8px} .rv-meta{grid-column:1/-1} }
</style>
