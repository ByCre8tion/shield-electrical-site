---
/* Path of power: a pinned scroll story on a schematic. As you scroll, current draws from the
   utility feed through the meter and main panel out to the circuits, and the current step grows.
   Progress is written to --p by site.js (powerPath). Fully drawn without scripts or with reduced motion. */
const steps = [
  { n: '01', t: 'Service and meter', d: 'Where the utility hands power to you. We coordinate with SRP or APS for new service and upgrades.' },
  { n: '02', t: 'Main panel', d: 'The heart of the system. 100 to 200 amp upgrades, often with power back the same day.' },
  { n: '03', t: 'Branch circuits', d: 'New dedicated circuits for AC, kitchens, spas, shops and casitas, sized by load calculation.' },
  { n: '04', t: 'At the device', d: 'EV chargers, lighting, fans and outlets. Finished clean, tested and inspected.' },
];
const loads = [
  { y: 110, k: 'LIGHTING' }, { y: 240, k: 'EV CHARGER' }, { y: 370, k: 'AC CONDENSER' }, { y: 500, k: 'OUTLETS' },
];
---
<section class="pp" data-powerpath aria-labelledby="pp-h">
  <div class="pp-pin gridbg">
    <div class="pp-word" aria-hidden="true">POWER ON</div>
    <div class="wrap pp-grid">
      <div class="pp-copy">
        <h2 id="pp-h" class="t-h2">From the street to the switch</h2>
        <ol class="pp-steps">
          {steps.map((s, i) => (
            <li data-step={i}><span class="val">{s.n}</span><span><b>{s.t}</b><span>{s.d}</span></span></li>
          ))}
        </ol>
      </div>
      <svg class="pp-svg" viewBox="0 0 1000 610" role="img" aria-label="Schematic: utility feed to meter to main panel to four branch circuits">
        <defs>
          <filter id="ppglow" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="4" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
        </defs>
        <g class="pp-base">
          <circle cx="70" cy="305" r="26" /><circle cx="104" cy="305" r="26" />
          <path d="M130 305H286" /><circle cx="320" cy="305" r="34" />
          <path d="M354 305H500" /><rect x="500" y="195" width="120" height="220" rx="6" />
          {[0,1,2,3,4,5,6,7].map((k) => <rect x={k % 2 ? 566 : 518} y={220 + Math.floor(k / 2) * 46} width="36" height="16" rx="3" />)}
          <path d="M620 305H700M700 110V500" />
          {loads.map((l) => <path d={`M700 ${l.y}H860`} />)}
          {loads.map((l) => <rect x="860" y={l.y - 22} width="44" height="44" rx="8" />)}
        </g>
        <g class="pp-live" filter="url(#ppglow)">
          <path class="s1" pathLength="1" d="M130 305H286" />
          <path class="s2" pathLength="1" d="M354 305H500" />
          <path class="s3" pathLength="1" d="M620 305H700" />
          <path class="s4" pathLength="1" d="M700 305V110" /><path class="s4" pathLength="1" d="M700 305V500" />
          {loads.map((l) => <path class="s5" pathLength="1" d={`M700 ${l.y}H860`} />)}
        </g>
        <g class="pp-nodes">
          <circle class="n1" cx="320" cy="305" r="34" />
          <rect class="n2" x="500" y="195" width="120" height="220" rx="6" />
          {loads.map((l) => <rect class="n3" x="860" y={l.y - 22} width="44" height="44" rx="8" />)}
        </g>
        <g class="pp-labels">
          <text x="87" y="365" text-anchor="middle">UTILITY FEED</text>
          <text x="320" y="310" text-anchor="middle" class="big">kWh</text><text x="320" y="370" text-anchor="middle">METER</text>
          <text x="560" y="440" text-anchor="middle">MAIN 200A</text>
          {loads.map((l) => <text x="920" y={l.y + 4}>{l.k}</text>)}
        </g>
      </svg>
    </div>
  </div>
</section>
<style is:global>
.pp{--p:1;position:relative;height:280vh}
.pp-pin{position:sticky;top:0;height:100svh;min-height:620px;display:flex;align-items:center;overflow:hidden}
.pp-word{position:absolute;left:50%;top:50%;translate:-50% -50%;font-weight:600;font-size:clamp(5rem,17vw,17rem);line-height:.8;letter-spacing:-.06em;white-space:nowrap;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.08);pointer-events:none}
.pp-grid{position:relative;width:100%;display:grid;grid-template-columns:minmax(0,4fr) minmax(0,7fr);gap:clamp(32px,5vw,72px);align-items:center}
.pp-copy{display:flex;flex-direction:column;gap:22px}
.pp-steps{list-style:none;display:flex;flex-direction:column;gap:6px;margin-top:8px}
.pp-steps li{display:grid;grid-template-columns:36px 1fr;gap:12px;padding:12px 0;opacity:.38;transition-property:opacity;transition-duration:.3s;transition-timing-function:ease-out}
.pp-steps li .val{font-size:.8125rem;color:var(--ink-3);padding-top:4px}
.pp-steps b{display:block;font-weight:500;font-size:1.0625rem;color:var(--ink);transition:font-size .3s var(--snap)}
.pp-steps li>span>span{display:block;max-height:0;overflow:hidden;font-size:.9375rem;color:var(--ink-2);transition:max-height .4s var(--snap)}
.pp-steps li.on{opacity:1}
.pp-steps li.on b{font-size:1.5rem}
.pp-steps li.on .val{color:var(--volt)}
.pp-steps li.on>span>span{max-height:6em;margin-top:6px}
.pp-svg{width:100%;height:auto;overflow:visible}
.pp-base *{fill:none;stroke:rgba(255,255,255,.2);stroke-width:1.5}
.pp-live path{fill:none;stroke:var(--volt);stroke-width:2.5;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1}
.pp-live .s1{stroke-dashoffset:calc(1 - clamp(0, var(--p) * 5, 1))}
.pp-live .s2{stroke-dashoffset:calc(1 - clamp(0, (var(--p) - .2) * 5, 1))}
.pp-live .s3{stroke-dashoffset:calc(1 - clamp(0, (var(--p) - .45) * 10, 1))}
.pp-live .s4{stroke-dashoffset:calc(1 - clamp(0, (var(--p) - .55) * 8, 1))}
.pp-live .s5{stroke-dashoffset:calc(1 - clamp(0, (var(--p) - .7) * 6, 1))}
.pp-nodes *{fill:none;stroke:var(--volt);stroke-width:2;opacity:0;transition:opacity .3s ease-out}
.pp[data-s="1"] .n1,.pp[data-s="2"] .n1,.pp[data-s="3"] .n1,.pp[data-s="2"] .n2,.pp[data-s="3"] .n2,.pp[data-s="3"] .n3{opacity:1;filter:drop-shadow(0 0 6px rgba(242,207,74,.6))}
.pp-labels text{font:500 13px var(--mono);letter-spacing:.1em;fill:var(--ink-3)}
.pp-labels .big{font-size:18px;fill:var(--ink-2);letter-spacing:0}
@media (max-width:900px){
  .pp{height:auto}
  .pp-word{display:none}
  .pp-pin{position:relative;height:auto;min-height:0;padding-block:var(--sec)}
  .pp-grid{grid-template-columns:minmax(0,1fr)}
  .pp-steps li{opacity:1}.pp-steps li>span>span{max-height:none;margin-top:6px}.pp-steps b{font-size:1.0625rem!important}
  .pp-nodes *{opacity:1}
}
</style>
