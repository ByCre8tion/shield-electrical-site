---
/* Bottom right concierge: one conversation with Jason's assistant. It answers questions and, when someone wants a quote,
   asks for their name and number right in the thread. data-ai-endpoint and data-sms-endpoint get filled in Phase 3. */
import { company as contact } from '../data/site';
const send = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 16V4.5M5 9l5-5 5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const x = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>';
const chev = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const face = '/brand/jason.webp';
---
<div class="cg" id="cg" data-ai-endpoint="" data-sms-endpoint="" data-tel={contact.tel} data-phone={contact.phone}>
  <div class="cg-scrim" id="cgScrim" aria-hidden="true"></div>

  <div class="cg-hello" id="cgHello" hidden>
    <button type="button" class="cg-hello-x" id="cgHelloX" aria-label="Dismiss message" set:html={x} />
    <button type="button" class="cg-hello-body" id="cgHelloOpen">
      <img class="cg-face" src={face} alt="" width="40" height="40" />
      <span><b>Jason <i>Shield Electrical</i></b><span id="cgHelloText">Questions about a project? I can help, or text you back.</span></span>
    </button>
  </div>

  <section class="cg-panel" id="cgPanel" role="dialog" aria-modal="false" aria-labelledby="cgTitle" hidden>
    <div class="cg-grab" id="cgGrab" aria-hidden="true"><span></span></div>
    <header class="cg-head">
      <span class="cg-face-wrap"><img class="cg-face" src={face} alt="" width="44" height="44" /></span>
      <div class="cg-who"><h2 id="cgTitle">Jason</h2><p>Owner, Shield Electrical</p></div>
      <a class="cg-icon-btn" href={`tel:${contact.tel}`} aria-label={`Call ${contact.phone}`}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6.6 3.5 8.4 6.8 7 8.6c.8 1.8 2.5 3.5 4.4 4.4l1.8-1.4 3.3 1.8-.6 2.6c-.1.5-.6.9-1.2.9C8.7 16.6 3.4 11.3 3.1 5.3c0-.6.3-1 .9-1.2z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></a>
      <button type="button" class="cg-icon-btn" id="cgClose" aria-label="Close chat" set:html={x} />
    </header>

    <div class="cg-thread" id="cgThread" data-lenis-prevent>
      <p class="cg-day" id="cgDay">Today</p>
      <div class="cg-log" id="cgLog" role="log" aria-live="polite" aria-relevant="additions"></div>
      <div class="cg-actions" id="cgActions">
        <button type="button" data-act="quote"><span class="cg-act-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3.5h7.5L19 8v12.5H7z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M14 3.5V8.5h5M10 13h6M10 16.5h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span><span><b>Get a quote</b><span>We text you back</span></span><Fragment set:html={chev} /></button>
        <a href="/projects/" data-act="work"><span class="cg-act-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m4 16 5-5 4 4 2.5-2.5L20 17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></span><span><b>See our work</b><span>Finished projects</span></span><Fragment set:html={chev} /></a>
        <a href={`tel:${contact.tel}`} data-act="call"><span class="cg-act-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 4.5 10.2 8.5 8.5 10.7c1 2.2 3 4.2 5.3 5.3l2.2-1.7 4 2.2-.7 3.1c-.1.6-.7 1-1.4 1C10.4 20.2 4 13.8 3.6 6.4c0-.7.4-1.2 1-1.4z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></span><span><b>Call now</b><span>{contact.phone}</span></span><Fragment set:html={chev} /></a>
      </div>
    </div>

    <form class="cg-compose" id="cgForm" novalidate>
      <p class="cg-legal" id="cgLegal" hidden>By sending your number, you agree to receive texts from Shield Electrical. Message and data rates may apply. Reply STOP to opt out.</p>
      <div class="cg-row">
        <label class="sr-only" for="cgQ" id="cgQLabel">Message</label>
        <textarea id="cgQ" rows="1" placeholder="Ask a question" maxlength="500" autocomplete="off"></textarea>
        <button type="submit" class="cg-send" id="cgSend" aria-label="Send" disabled set:html={send} />
      </div>
    </form>
  </section>

  <button type="button" class="cg-launch" id="cgLaunch" aria-expanded="false" aria-controls="cgPanel">
    <span class="cg-launch-face"><img src={face} alt="" width="36" height="36" /><span class="cg-launch-chat" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 4.5A1.5 1.5 0 0 1 4.5 3h7A1.5 1.5 0 0 1 13 4.5v5a1.5 1.5 0 0 1-1.5 1.5H7l-3 2.5V11a1 1 0 0 1-1-1z" fill="currentColor"/></svg></span><span class="cg-badge" id="cgBadge" hidden>1</span></span>
    <span class="cg-label">Text us</span>
    <span class="cg-launch-x" aria-hidden="true" set:html={x} />
  </button>
</div>

<style is:global>
/* Shield dark remap of the shared concierge styles */
.cg{--white:#16181A;--ink:#F2EEE6;--chalk:#1F2225;--rule:rgba(242,238,230,.12);--rule-strong:rgba(242,238,230,.26);--muted:#9BA0A5;--stone:#2A2D31;--plaster:rgba(207,170,102,.14);--ember:#FBDB9B;--orange:#CFAA66;--ink-2:#9BA0A5;--plaster-2:#4A4E53;color:#F2EEE6}
.cg .cg-launch{background:#1F2225;color:#F2EEE6;box-shadow:0 0 0 1px rgba(207,170,102,.35),0 14px 34px -10px rgba(0,0,0,.7)}
@media (hover:hover){.cg .cg-launch:hover{background:#2A2D31}}
.cg .cg-badge,.cg .cg-launch-chat{color:#121315;box-shadow:0 0 0 2px #1F2225}
.cg .cg-msg.me .cg-bub{background:var(--brass);color:#121315}
.cg .cg-send{background:var(--brass);color:#121315}
.cg .cg-send:disabled{background:#2A2D31;color:#6B7075}
.cg .cg-hello,.cg .cg-panel{box-shadow:0 0 0 1px rgba(242,238,230,.06),0 30px 60px -20px rgba(0,0,0,.75)}
.cg .cg-tick{color:#121315}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.cg{--cg-r:12px;--cg-ease:cubic-bezier(.16,1,.3,1);position:fixed;right:max(16px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));z-index:60;display:flex;flex-direction:column;align-items:flex-end;gap:12px;font-size:0.9375rem}
.cg [hidden]{display:none!important}
.editing .cg,.menu-open .cg{display:none}
.cg-face{width:40px;height:40px;border-radius:50%;object-fit:cover;background:var(--stone);outline:1px solid rgba(0,0,0,.08);outline-offset:-1px}

/* Launcher: Jason's face and a label, collapses to a close button when open */
.cg-launch{position:relative;display:inline-flex;align-items:center;gap:10px;height:52px;padding:0 20px 0 8px;border-radius:999px;background:var(--ink);color:var(--white);font-weight:600;font-size:0.9375rem;box-shadow:0 0 0 1px rgba(255,255,255,.06),0 12px 32px -10px rgba(25,28,29,.5);transition:background-color .2s ease-out,transform .15s ease-out,padding .3s var(--cg-ease),width .3s var(--cg-ease);-webkit-tap-highlight-color:transparent}
.cg-launch:active{transform:scale(.96)}
@media (hover:hover){.cg-launch:hover{background:#000}}
.cg-launch-face{position:relative;display:block;width:36px;height:36px}
.cg-launch-face img{width:36px;height:36px;border-radius:50%;object-fit:cover}
.cg-badge{position:absolute;top:-4px;right:-4px;min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:var(--orange);color:var(--ink);font-size:0.6875rem;font-weight:700;line-height:18px;text-align:center;box-shadow:0 0 0 2px var(--ink);animation:cg-badge .4s var(--cg-ease) both}
@keyframes cg-badge{from{transform:scale(.25);opacity:0}}
.cg-launch-chat{display:none}
.cg-launch-x{display:none;width:22px;height:22px}
.cg-launch-x svg{width:22px;height:22px}
.cg.open .cg-launch{padding:0;width:52px;justify-content:center}
.cg.open .cg-launch-face,.cg.open .cg-label{display:none}
.cg.open .cg-launch-x{display:block}

/* Greeting */
.cg-hello{position:relative;max-width:300px;background:var(--white);border:1px solid var(--rule);border-radius:var(--cg-r);box-shadow:0 18px 40px -18px rgba(25,28,29,.4);animation:cg-pop .5s var(--cg-ease) both;transform-origin:bottom right}
.cg-hello-body{display:flex;gap:12px;align-items:flex-start;padding:14px 36px 16px 14px;text-align:left;font-size:0.9375rem;line-height:1.45;color:var(--ink)}
.cg-hello-body b{display:flex;gap:6px;align-items:baseline;font-weight:600;font-size:0.875rem;margin-bottom:3px}
.cg-hello-body b i{font-style:normal;font-weight:400;color:var(--muted);font-size:0.8125rem}
.cg-hello-x{position:absolute;top:4px;right:4px;width:32px;height:32px;display:grid;place-items:center;color:var(--muted);border-radius:50%}
.cg-hello-x svg{width:15px;height:15px}
@keyframes cg-pop{from{opacity:0;transform:translateY(8px) scale(.96)}}

/* Panel */
.cg-scrim{display:none}
.cg-panel{width:min(392px,calc(100vw - 32px));height:min(640px,calc(100dvh - 112px));display:flex;flex-direction:column;background:var(--white);border:1px solid var(--rule);border-radius:16px;overflow:hidden;box-shadow:0 32px 64px -24px rgba(25,28,29,.45);transform-origin:bottom right}
.cg-panel.in{animation:cg-in .45s var(--cg-ease) both}
.cg-panel.leaving{animation:cg-out .18s ease-out both}
@keyframes cg-in{from{opacity:0;transform:translateY(12px) scale(.97)}}
@keyframes cg-out{to{opacity:0;transform:translateY(8px) scale(.99)}}
.cg-grab{display:none}
.cg-head{display:flex;align-items:center;gap:12px;padding:14px 8px 14px 16px;border-bottom:1px solid var(--rule);background:var(--white)}
.cg-face-wrap{position:relative;flex:none}
.cg-head .cg-face{width:44px;height:44px}
.cg-who{min-width:0;margin-right:auto}
.cg-who h2{font-family:var(--body);font-size:1rem;font-weight:600;line-height:1.25;text-transform:none;letter-spacing:0;color:var(--ink)}
.cg-who p{font-size:0.8125rem;color:var(--muted)}
.cg-icon-btn{width:40px;height:40px;display:grid;place-items:center;border-radius:50%;color:var(--ink-2);transition:background-color .15s ease-out}
.cg-icon-btn svg{width:19px;height:19px}
@media (hover:hover){.cg-icon-btn:hover{background:var(--chalk)}}

.cg-thread{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:14px 16px 18px;display:flex;flex-direction:column;gap:8px;background:var(--white)}
.cg-day{align-self:center;font-size:0.75rem;font-weight:500;color:var(--muted);margin-bottom:4px}
.cg-log{display:flex;flex-direction:column;gap:6px}
.cg-msg{display:flex;flex-direction:column;max-width:84%;animation:cg-msg .3s ease-out both}
.cg-msg.bot{align-self:flex-start}
.cg-msg.me{align-self:flex-end;align-items:flex-end}
.cg-bub{padding:10px 14px;border-radius:var(--cg-r);line-height:1.5;font-size:0.9375rem;overflow-wrap:anywhere}
.cg-msg.bot .cg-bub{background:var(--chalk);color:var(--ink);border-bottom-left-radius:4px}
.cg-msg.me .cg-bub{background:var(--ink);color:var(--white);border-bottom-right-radius:4px}
.cg-bub a{color:var(--ember);font-weight:600;text-decoration:underline;text-underline-offset:2px}
.cg-bub p+p{margin-top:6px}
.cg-meta{display:flex;align-items:center;gap:4px;margin-top:4px;padding-inline:4px;font-size:0.6875rem;color:var(--muted);font-variant-numeric:tabular-nums}
.cg-meta svg{width:13px;height:13px;color:var(--ember)}
.cg-msg+.cg-msg.me,.cg-msg.me+.cg-msg.bot{margin-top:6px}
@keyframes cg-msg{from{opacity:0;transform:translateY(6px)}}
.cg-dots{display:inline-flex;gap:4px;padding:5px 0}
.cg-dots i{width:6px;height:6px;border-radius:50%;background:var(--muted);animation:cg-dot 1s ease-in-out infinite}
.cg-dots i:nth-child(2){animation-delay:.15s}.cg-dots i:nth-child(3){animation-delay:.3s}
@keyframes cg-dot{0%,60%,100%{opacity:.3}30%{opacity:1}}
.cg-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:2px}
.cg-chips button{padding:7px 12px;border:1px solid var(--rule-strong);border-radius:999px;background:var(--white);font-size:0.8125rem;font-weight:500;color:var(--ink);transition:border-color .15s ease-out}
@media (hover:hover){.cg-chips button:hover{border-color:var(--ink)}}

.cg-actions{display:flex;flex-direction:column;border:1px solid var(--rule);border-radius:var(--cg-r);overflow:hidden;margin-top:8px}
.cg-actions>*{display:flex;align-items:center;gap:12px;padding:12px 12px 12px 14px;text-align:left;background:var(--white);transition:background-color .15s ease-out}
.cg-actions>*+*{border-top:1px solid var(--rule)}
.cg-actions>* > span:nth-child(2){flex:1;display:flex;flex-direction:column;min-width:0}
.cg-actions b{font-size:0.9375rem;font-weight:600;color:var(--ink)}
.cg-actions span span{font-size:0.8125rem;color:var(--muted)}
.cg-actions>* > svg{width:18px;height:18px;color:var(--muted)}
.cg-act-ico{flex:none;width:36px;height:36px;border-radius:10px;display:grid;place-items:center;background:var(--plaster);color:var(--ember)}
.cg-act-ico svg{width:20px;height:20px}
@media (hover:hover){.cg-actions>*:hover{background:var(--chalk)}}
.cg-actions>*:active{background:var(--chalk)}

.cg-compose{border-top:1px solid var(--rule);padding:10px 12px calc(10px + env(safe-area-inset-bottom,0px) * 0);background:var(--white)}
.cg-legal{font-size:0.6875rem;line-height:1.45;color:var(--muted);padding:0 4px 8px}
.cg-row{display:flex;align-items:flex-end;gap:8px}
.cg-row textarea{flex:1;resize:none;max-height:120px;padding:11px 16px;border:1px solid var(--rule-strong);border-radius:22px;font:inherit;font-size:1rem;line-height:1.35;background:var(--white);color:var(--ink)}
.cg-row textarea:focus-visible{outline:2px solid var(--ember);outline-offset:1px}
.cg-row textarea[aria-invalid=true]{border-color:#B3261E}
.cg-send{flex:none;width:44px;height:44px;display:grid;place-items:center;border-radius:50%;background:var(--ink);color:var(--white);transition:background-color .15s ease-out,color .15s ease-out,transform .15s ease-out}
.cg-send svg{width:18px;height:18px}
.cg-send:disabled{background:var(--stone);color:var(--muted)}
.cg-send:not(:disabled):active{transform:scale(.96)}
.cg-send:focus-visible,.cg-launch:focus-visible,.cg-icon-btn:focus-visible,.cg-actions>*:focus-visible,.cg-chips button:focus-visible,.cg-hello button:focus-visible{outline:2px solid var(--ember);outline-offset:2px}

/* Phones: a full screen sheet that slides up, with a handle to drag it down */
@media (max-width:640px){
  .cg-label{display:none}
  .cg-launch{width:56px;height:56px;padding:0;justify-content:center}
  .cg-launch-face,.cg-launch-face img{width:56px;height:56px}
  .cg-launch-chat{display:grid;place-items:center;position:absolute;right:-2px;bottom:-2px;width:22px;height:22px;border-radius:50%;background:var(--orange);color:var(--ink);box-shadow:0 0 0 2px var(--white)}
  .cg-launch-chat svg{width:12px;height:12px}
  .cg.open .cg-launch{display:none}
  .cg-hello{max-width:calc(100vw - 32px)}
  .cg-scrim{display:block;position:fixed;inset:0;background:rgba(25,28,29,.4);opacity:0;pointer-events:none;transition:opacity .3s ease-out}
  .cg.open .cg-scrim{opacity:1;pointer-events:auto}
  .cg-panel{position:fixed;left:0;right:0;bottom:0;width:100%;height:calc(100dvh - 24px - env(safe-area-inset-top,0px));border-radius:16px 16px 0 0;border:0;transform-origin:bottom center;touch-action:pan-y}
  .cg-panel.in{animation:cg-up .45s var(--cg-ease) both}
  .cg-panel.leaving{animation:cg-down .25s ease-in both}
  .cg-panel.dragging{animation:none;transition:none}
  .cg-panel.settle{transition:transform .3s var(--cg-ease)}
  @keyframes cg-up{from{transform:translateY(100%)}}
  @keyframes cg-down{to{transform:translateY(100%)}}
  .cg-grab{display:flex;justify-content:center;padding:8px 0 2px;cursor:grab;touch-action:none}
  .cg-grab span{width:40px;height:5px;border-radius:3px;background:var(--plaster-2)}
  .cg-head{padding-top:6px;touch-action:none}
  .cg-compose{padding-bottom:calc(10px + env(safe-area-inset-bottom,0px))}
}
@media (prefers-reduced-motion:reduce){
  .cg-hello,.cg-panel.in,.cg-panel.leaving,.cg-msg,.cg-dots i,.cg-badge{animation:none}
}
</style>
