---
import { company } from '../data/site';
interface Props { title: string; text?: string; cta?: string; href?: string }
const { title, text, cta = 'Schedule service', href = '/contact/' } = Astro.props;
---
<section class="brass" aria-label={title}>
  <div class="wrap brass-in">
    <p class="readout">Shield Electrical · {company.city}</p>
    <h2 class="t-h1" data-reveal>{title}</h2>
    {text && <p class="brass-p" data-reveal>{text}</p>}
    <div class="brass-cta" data-reveal><a class="btn btn-ink" href={href}>{cta} <span class="arr" aria-hidden="true">→</span></a><a class="tel" href={`tel:${company.tel}`}>{company.phone}</a></div>
  </div>
</section>
<style is:global>
.brass{background:var(--brass-grad);color:var(--ink);--fg:var(--ink);--fg-2:#3A2C14;--accent:var(--ink)}
.brass-in{padding-block:clamp(80px,10vw,144px);display:flex;flex-direction:column;gap:24px;align-items:flex-start}
.brass h2{max-width:17ch;color:var(--ink);font-stretch:125%}
.brass .readout{color:#3A2C14}
.brass-p{max-width:52ch;font-size:1.125rem;color:#2A2116}
.brass-cta{display:flex;flex-wrap:wrap;align-items:center;gap:20px;margin-top:8px}
.brass .tel{color:var(--ink);font-size:1rem}
.brass :focus-visible{outline-color:var(--ink)}
</style>
