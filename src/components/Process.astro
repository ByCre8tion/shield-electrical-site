---
/* The process as a conductor: current fills the line node to node as it scrolls into view */
import { steps } from '../data/site';
---
<div class="cond" data-conductor>
  <div class="cond-line" aria-hidden="true"><span class="cond-fill"></span></div>
  <ol class="cond-steps">
    {steps.map((s) => (
      <li class="cond-step">
        <span class="cond-node" aria-hidden="true"></span>
        <h3 class="t-h3">{s.t}</h3>
        <p class="small">{s.d}</p>
      </li>
    ))}
  </ol>
</div>
<style is:global>
.cond{position:relative;padding-top:8px}
.cond-line{position:absolute;left:0;right:0;top:19px;height:2px;border-radius:2px;background:var(--seam-2);overflow:hidden}
.cond-fill{display:block;height:100%;width:100%;background:linear-gradient(90deg,var(--gold),var(--gold-hi));transform:scaleX(var(--p,0));transform-origin:left;box-shadow:0 0 12px rgba(243,221,168,.7)}
.cond-steps{list-style:none;position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(20px,3vw,40px)}
.cond-step{display:flex;flex-direction:column;gap:12px;padding-right:8px}
.cond-node{width:24px;height:24px;border-radius:50%;background:var(--night);border:2px solid var(--seam-2);margin-bottom:12px;transition:border-color .3s var(--snap),box-shadow .3s var(--snap),background-color .3s var(--snap)}
.cond-step.on .cond-node{border-color:var(--gold);background:var(--gold);box-shadow:0 0 0 5px rgba(216,183,118,.18),0 0 18px rgba(243,221,168,.6)}
@media (max-width:760px){
  .cond-line{left:11px;right:auto;top:8px;bottom:8px;width:2px;height:auto}
  .cond-fill{transform:scaleY(var(--p,0));transform-origin:top;width:100%;height:100%}
  .cond-steps{grid-template-columns:minmax(0,1fr);gap:28px}
  .cond-step{padding-left:44px;position:relative}
  .cond-node{position:absolute;left:0;top:0;margin:0}
}
</style>
