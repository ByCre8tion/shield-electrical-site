---
import { steps } from '../data/site';
---
<ol class="steps">
  {steps.map((s, i) => (
    <li data-reveal>
      <div class="rule-live"></div>
      <span class="readout">Step <b>{String(i + 1).padStart(2, '0')}</b></span>
      <h3 class="t-h3">{s.t}</h3>
      <p>{s.d}</p>
    </li>
  ))}
</ol>
<style is:global>
.steps{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(20px,3vw,40px)}
.steps li{display:flex;flex-direction:column;gap:14px}
.steps .rule-live{margin-bottom:10px}
.steps p{color:var(--fg-2);font-size:1rem}
@media (max-width:900px){.steps{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:520px){.steps{grid-template-columns:minmax(0,1fr)}}
</style>
