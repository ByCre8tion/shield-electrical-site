---
import { company, nav } from '../data/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const main = nav.filter((l) => ['/services/', '/gallery/', '/about/', '/service-areas/', '/blog/', '/faq/', '/careers/'].includes(l.href));
const primary = nav.filter((l) => ['/services/', '/gallery/', '/about/', '/blog/'].includes(l.href));
const secondary = nav.filter((l) => !primary.includes(l));
const cur = (h: string) => (path.startsWith(h) ? 'page' : undefined);
---
<a class="skip" href="#main">Skip to content</a>
<header class="nav" id="nav">
  <div class="nav-bar">
    <a class="nav-logo" href="/" aria-label="Shield Electrical home"><img src="/brand/shield-logo.svg" alt="" width="168" height="38" /></a>
    <nav class="nav-links" aria-label="Main">
      {main.map((l) => <a href={l.href} aria-current={cur(l.href)}>{l.label}</a>)}
    </nav>
    <div class="nav-end">
      <a class="btn btn-gold nav-cta" href="/contact/">Book service</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="sheet" data-menu aria-label="Menu"><Icon name="list" size={22} class="mb-open" /><Icon name="x" size={22} class="mb-close" /></button>
    </div>
  </div>
</header>
<div class="sheet" id="sheet" hidden>
  <nav aria-label="Menu" class="sheet-in">
    <ul class="sheet-main">
      {primary.map((l, i) => (
        <li style={`--i:${i}`}><a href={l.href} aria-current={cur(l.href)}><span class="val">{String(i + 1).padStart(2, '0')}</span>{l.label}</a></li>
      ))}
    </ul>
    <ul class="sheet-more" style="--i:4">
      {secondary.map((l) => <li><a href={l.href} aria-current={cur(l.href)}>{l.label}</a></li>)}
    </ul>
    <div class="sheet-foot" style="--i:5">
      <p class="sheet-open"><span data-open-status><span class="led" aria-hidden="true"></span><span data-open-text>{company.hours}</span></span></p>
      <div class="sheet-btns">
        <a class="btn btn-gold" href="/contact/">Book service <Icon name="arrow-right" size={18} class="ico-go" /></a>
        <a class="btn btn-line" href={`tel:${company.tel}`}><Icon name="phone" size={18} />Call</a>
      </div>
    </div>
  </nav>
</div>
<style is:global>
.nav{position:sticky;top:0;z-index:50;border-bottom:1px solid transparent;transition-property:background-color,border-color;transition-duration:.3s;transition-timing-function:ease-out}
.scrolled .nav{background:rgba(10,10,11,.72);-webkit-backdrop-filter:saturate(140%) blur(16px);backdrop-filter:saturate(140%) blur(16px);border-bottom-color:var(--seam)}
.nav-bar{max-width:var(--max);margin:0 auto;height:72px;padding-inline:var(--gut);display:flex;align-items:center;gap:32px}
.nav-logo img{height:30px;width:auto}
.nav-links{display:flex;margin-left:auto}
.nav-links{gap:8px}
.nav-links a{position:relative;padding:10px 12px;font-size:.9375rem;color:var(--ink-2);transition:color .15s var(--ease-out)}
.nav-links a[aria-current]{color:var(--ink)}
.nav-links a[aria-current]::after{content:"";position:absolute;left:50%;bottom:2px;width:4px;height:4px;margin-left:-2px;border-radius:50%;background:var(--volt)}
@media (hover:hover){.nav-links a:hover{color:var(--ink)}}
.nav-end{display:flex;align-items:center;gap:16px;margin-left:auto}

.nav-cta{min-height:44px;padding:0 20px;font-size:.9375rem}
.menu-btn .ico{grid-area:1/1;transition-property:opacity,scale,filter;transition-duration:var(--t-med);transition-timing-function:var(--ease-out)}
.mb-close,[aria-expanded=true] .mb-open{opacity:0;scale:.25;filter:blur(4px)}
[aria-expanded=true] .mb-close{opacity:1;scale:1;filter:blur(0)}
/* Menu sheet: fades in, links rise in one after another, once per open */
.sheet{transition:opacity var(--t-med) var(--ease-out)}
@starting-style{.sheet{opacity:0}.sheet-main li,.sheet-more,.sheet-foot{opacity:0;translate:0 16px}}
.sheet-main li,.sheet-more,.sheet-foot{transition-property:opacity,translate;transition-duration:.45s;transition-timing-function:var(--ease-out);transition-delay:calc(var(--i,0) * 40ms + 40ms)}
@media (prefers-reduced-motion:reduce){.sheet,.sheet-main li,.sheet-more,.sheet-foot{transition:none}}
.menu-btn{display:none;width:48px;height:48px;border-radius:50%;place-items:center;border:1px solid var(--seam-2)}
.sheet{position:fixed;inset:0;z-index:49;background:var(--night);overflow-y:auto;overscroll-behavior:contain;padding:96px 16px 40px}
.sheet[hidden]{display:none}
.sheet-in{min-height:100%;display:flex;flex-direction:column;gap:28px;max-width:560px;margin:0 auto}
.sheet-main{list-style:none;border-top:1px solid var(--seam)}
.sheet-main li{border-bottom:1px solid var(--seam)}
.sheet-main a{display:flex;align-items:baseline;gap:16px;padding:18px 0;font-size:clamp(2rem,9vw,2.75rem);font-weight:380;line-height:1.1;letter-spacing:-.03em;color:var(--ink)}
.sheet-main a .val{min-width:24px;font-size:.75rem;letter-spacing:0;color:var(--ink-3)}
.sheet-main a[aria-current]{color:var(--volt-hi)}.sheet-main a[aria-current] .val{color:var(--volt)}
.sheet-main a:active{color:var(--volt-hi)}
.sheet-more{list-style:none;display:flex;flex-wrap:wrap;gap:4px 24px}
.sheet-more a{display:inline-flex;align-items:center;min-height:44px;font-size:1rem;color:var(--ink-2)}
.sheet-more a[aria-current]{color:var(--volt-hi)}
.sheet-foot{margin-top:auto;display:flex;flex-direction:column;gap:16px;padding-top:20px;border-top:1px solid var(--seam)}
.sheet-open{font-size:.875rem;color:var(--ink-2)}
.sheet-open [data-open-status]{display:inline-flex;align-items:center;gap:8px}
.sheet-btns{display:flex;flex-wrap:wrap;gap:10px}
@media (max-width:1180px){.nav-status{display:none}}
@media (max-width:1120px){.nav-links{display:none}.menu-btn{display:grid}}
@media (max-width:520px){.nav-cta{display:none}.nav-logo img{height:26px}}
</style>
