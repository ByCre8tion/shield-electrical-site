---
import { company, nav } from '../data/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const main = nav.filter((l) => ['/services/', '/projects/', '/about/', '/reviews/', '/careers/'].includes(l.href));
const cur = (h: string) => (path.startsWith(h) ? 'page' : undefined);
---
<a class="skip" href="#main">Skip to content</a>
<header class="nav" id="nav">
  <div class="nav-bar">
    <a class="nav-logo" href="/" aria-label="Shield Electrical home"><img src="/brand/shield-logo.svg" alt="" width="168" height="38" /></a>
    <nav class="nav-links" aria-label="Main">
      {main.map((l) => <a href={l.href} aria-current={cur(l.href)}>{l.label}</a>)}
    </nav>
    <div class="nav-end">
      <a class="btn btn-gold nav-cta" href="/contact/">Book service</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="sheet" data-menu aria-label="Menu"><Icon name="list" size={22} /></button>
    </div>
  </div>
</header>
<div class="sheet" id="sheet" hidden>
  <nav aria-label="Menu" class="sheet-in">
    <ul>
      {[{ label: 'Home', href: '/' }, ...nav, { label: 'Book service', href: '/contact/' }].map((l) => (
        <li><a href={l.href} aria-current={l.href === '/' ? (path === '/' ? 'page' : undefined) : cur(l.href)}>{l.label}<Icon name="arrow-right" size={18} /></a></li>
      ))}
    </ul>
    <a class="btn btn-line sheet-call" href={`tel:${company.tel}`}><Icon name="phone" size={18} />Call <span class="val">{company.phone}</span></a>
  </nav>
</div>
<style is:global>
.nav{position:sticky;top:0;z-index:50;border-bottom:1px solid transparent;transition-property:background-color,border-color;transition-duration:.3s;transition-timing-function:ease-out}
.scrolled .nav{background:rgba(10,10,11,.72);-webkit-backdrop-filter:saturate(140%) blur(16px);backdrop-filter:saturate(140%) blur(16px);border-bottom-color:var(--seam)}
.nav-bar{max-width:var(--max);margin:0 auto;height:72px;padding-inline:var(--gut);display:flex;align-items:center;gap:32px}
.nav-logo img{height:30px;width:auto}
.nav-links{display:flex;margin-left:auto}
.nav-links{gap:8px}
.nav-links a{position:relative;padding:10px 12px;font-size:.9375rem;color:var(--ink-2);transition:color .15s ease-out}
.nav-links a[aria-current]{color:var(--ink)}
.nav-links a[aria-current]::after{content:"";position:absolute;left:50%;bottom:2px;width:4px;height:4px;margin-left:-2px;border-radius:50%;background:var(--volt);box-shadow:var(--bloom)}
@media (hover:hover){.nav-links a:hover{color:var(--ink)}}
.nav-end{display:flex;align-items:center;gap:16px;margin-left:auto}

.nav-cta{min-height:44px;padding:0 20px;font-size:.9375rem}
.menu-btn{display:none;width:48px;height:48px;border-radius:50%;place-items:center;border:1px solid var(--seam-2)}
.sheet{position:fixed;inset:0;z-index:49;background:rgba(10,10,11,.97);overflow-y:auto;overscroll-behavior:contain;padding:96px 16px 40px}
.sheet[hidden]{display:none}
.sheet-in{max-width:560px;margin:0 auto;display:flex;flex-direction:column;gap:20px}
.sheet ul{list-style:none;display:flex;flex-direction:column;gap:6px}
.sheet li a{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-radius:var(--r-panel);background:var(--deck);border:1px solid var(--seam);font-size:1.375rem;font-weight:300;letter-spacing:-.02em}
.sheet li a .ico{color:var(--ink-3)}
.sheet li a[aria-current]{border-color:rgba(242,207,74,.45)}
.sheet li a[aria-current] .ico{color:var(--gold)}
.sheet-call{align-self:flex-start}
@media (max-width:1180px){.nav-status{display:none}}
@media (max-width:980px){.nav-links{display:none}.menu-btn{display:grid}}
@media (max-width:520px){.nav-cta{display:none}.nav-logo img{height:26px}}
</style>
