---
/* In the field: the team at work. Five frames in an uneven grid, each tagged like a camera frame.
   Placeholders until Jason sends real job photos; real photos show in black and white and warm on hover. */
import Photo from './Photo.astro';
interface Props { title?: string; note?: string }
const { title = 'The crew, in the field', note = 'Real Shield jobs, real people. No stock photos.' } = Astro.props;
const frames = [
  { k: 'field1', r: '4 / 5', c: 'fg-a' },
  { k: 'field2', r: '4 / 3', c: 'fg-b' },
  { k: 'field3', r: '4 / 3', c: 'fg-c' },
  { k: 'field4', r: '16 / 10', c: 'fg-d' },
  { k: 'field5', r: '16 / 10', c: 'fg-e' },
];
---
<section class="sec fg" aria-labelledby="fg-h">
  <div class="wrap">
    <div class="fg-head"><h2 id="fg-h" class="t-h2" data-on>{title}</h2><p class="hud" data-on>{note}</p></div>
    <div class="fg-grid">
      {frames.map((f, i) => <div class:list={['fg-cell', f.c]} data-on><Photo k={f.k} ratio={f.r} tag={`Frame 0${i + 1}`} sizes="(max-width: 900px) 100vw, 40vw" /></div>)}
    </div>
  </div>
</section>
<style is:global>
.fg-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px 32px;flex-wrap:wrap;margin-bottom:clamp(28px,4vw,48px)}
.fg-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px}
.fg-a{grid-column:1 / 7;grid-row:1 / 3}
.fg-b{grid-column:7 / 10;grid-row:1}.fg-c{grid-column:10 / 13;grid-row:1}
.fg-d{grid-column:7 / 10;grid-row:2}.fg-e{grid-column:10 / 13;grid-row:2}
.fg-cell .photo{height:100%;aspect-ratio:auto!important;min-height:220px}
@media (max-width:760px){.fg-grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.fg-cell{grid-column:auto!important;grid-row:auto!important}.fg-a{grid-column:1 / -1!important}.fg-cell .photo{min-height:180px}.fg-a .photo{min-height:300px}}
</style>
