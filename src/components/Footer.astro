---
/* Footer v3: particle wordmark, then a turning particle globe beside plain link columns.
   References: particle footer, globe stats. Canvases in src/scripts/wordmark.js and globe.js. */
import { company, nav, services } from '../data/site';
import Socials from './Socials.astro';
import BbbSeal from './BbbSeal.astro';
const year = new Date().getFullYear();
---
<footer class="foot">
  <canvas class="foot-word" data-wordmark role="img" aria-label="Shield"></canvas>
  <div class="wrap foot-main">
    <div class="foot-globe">
      <canvas data-globe aria-hidden="true"></canvas>
      <div class="foot-globe-hud hud" aria-hidden="true"><span>Focus <b>Scottsdale, AZ</b></span><span>Service <b>Phoenix Valley</b></span></div>
    </div>
    <div class="foot-cols">
      <div class="foot-brand">
        <img src="/brand/shield-logo.svg" alt="Shield Electrical" width="190" height="43" />
        <p>Licensed commercial and residential electrical contractor. Written price before any work starts.</p>
        <Socials />
      </div>
      <nav aria-label="Services" class="foot-col"><h2 class="label">Services</h2><ul>{services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}</ul></nav>
      <nav aria-label="Company" class="foot-col"><h2 class="label">Company</h2><ul>{nav.filter((l) => l.href !== '/services/').map((l) => <li><a href={l.href}>{l.label}</a></li>)}<li><a href="/contact/">Book service</a></li></ul></nav>
      <div class="foot-col"><h2 class="label">Reach us</h2>
        <ul>
          <li><a class="val foot-tel" href={`tel:${company.tel}`}>{company.phone}</a></li>
          <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
          <li>{company.address}<br />{company.city}</li>
          <li><span>{company.hours}</span></li>
        </ul>
      </div>
      <div class="foot-trust"><BbbSeal /><span class="val">{company.roc}</span></div>
    </div>
  </div>
  <div class="wrap foot-base"><span class="label">© {year} {company.legal}</span><span class="label">Bonded and insured in Arizona</span></div>
</footer>
<style is:global>
.foot{position:relative;padding-top:clamp(48px,8vw,120px);border-top:1px solid var(--seam);overflow:hidden}
.foot-word{display:block;width:100%;height:clamp(120px,20vw,280px)}
.foot-main{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(32px,5vw,72px);align-items:center;padding-block:clamp(32px,5vw,64px)}
.foot-globe{position:relative;aspect-ratio:1;max-width:520px;width:100%}
.foot-globe canvas{width:100%;height:100%}
.foot-globe-hud{position:absolute;left:0;bottom:0;display:flex;flex-direction:column;gap:6px}
.foot-cols{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px 28px}
.foot-brand{grid-column:1 / -1;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px;padding-bottom:28px;border-bottom:1px solid var(--seam)}
.foot-brand img{height:38px;width:auto}
.foot-brand p{flex:1 1 260px;max-width:40ch;font-size:.9375rem;color:var(--ink-2)}
.foot-col h2{margin-bottom:16px}
.foot-col ul{list-style:none;display:flex;flex-direction:column;gap:10px;font-size:.9375rem;color:var(--ink-2)}
.foot-col a{color:var(--ink-2);transition:color .15s var(--ease-out)}
@media (hover:hover){.foot-col a:hover{color:var(--ink)}}
.foot-trust{grid-column:1 / -1;display:flex;flex-wrap:wrap;align-items:center;gap:16px;color:var(--ink-3)}
.foot-base{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;padding-block:24px 32px;border-top:1px solid var(--seam)}
@media (max-width:980px){.foot-main{grid-template-columns:minmax(0,1fr)}.foot-globe{margin:0 auto;max-width:420px}}
@media (max-width:640px){.foot-globe{max-width:260px}.foot-word{height:96px}.foot-cols{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.foot-cols .foot-col:nth-child(4){grid-column:1 / -1}}
</style>
