---
import { company } from '../data/site';
import reviews from '../data/reviews.json';
import BbbSeal from './BbbSeal.astro';
import Icon from './Icon.astro';
const years = new Date().getFullYear() - company.since;
const g = '<svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>';
---
<section class="wrap trustbar-wrap" aria-label="Credentials">
  <ul class="panel trustbar" data-on>
    <li><a class="tb-g" href="/reviews/"><span class="tb-gdot" set:html={g} /><span><b><span class="val">{reviews.rating.toFixed(1)}</span> on Google</b><span class="tb-stars" aria-label={`${reviews.total} reviews`}>{[1,2,3,4,5].map(() => <Icon name="fill:star" size={13} />)}<span>{reviews.total} reviews</span></span></span></a></li>
    <li><Icon name="calendar-check" size={22} class="tb-ico" /><span><b><span class="val" data-meter={years}>{years}</span> years</b><span>wiring the Valley</span></span></li>
    <li><Icon name="shield-check" size={22} class="tb-ico" /><span><b>Licensed and insured</b><span class="val">{company.roc}</span></span></li>
    <li class="tb-bbb"><BbbSeal /></li>
  </ul>
</section>
<style is:global>
.trustbar-wrap{position:relative;margin-top:-28px;z-index:2}
.trustbar{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:center;padding:10px}
.trustbar>li{display:flex;align-items:center;gap:14px;padding:12px 18px;min-width:0}
.trustbar>li+li{border-left:1px solid var(--seam)}
.trustbar b{display:block;font-weight:500;font-size:.9375rem;color:var(--ink)}
.trustbar li span>span{font-size:.8125rem;color:var(--ink-2)}
.tb-g{display:flex;align-items:center;gap:14px;border-radius:14px}
.tb-gdot{flex:none;width:38px;height:38px;border-radius:50%;background:#fff;display:grid;place-items:center}
.tb-gdot svg{width:20px;height:20px}
.tb-stars{display:flex;align-items:center;gap:2px;color:#F4B400}
.tb-stars>span{margin-left:6px;color:var(--ink-2)}
.tb-ico{color:var(--gold)}
@media (hover:hover){.tb-g:hover b{color:var(--gold-hi)}}
@media (max-width:980px){.trustbar{grid-template-columns:repeat(2,minmax(0,1fr))}.trustbar>li:nth-child(3){border-left:0}.trustbar>li:nth-child(n+3){border-top:1px solid var(--seam)}}
@media (max-width:520px){.trustbar{grid-template-columns:minmax(0,1fr)}.trustbar>li+li{border-left:0;border-top:1px solid var(--seam)}}
</style>
