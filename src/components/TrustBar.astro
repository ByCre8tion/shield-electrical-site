---
import { company } from '../data/site';
import reviews from '../data/reviews.json';
import BbbSeal from './BbbSeal.astro';
import Icon from './Icon.astro';
const years = new Date().getFullYear() - company.since;
const g = '<svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>';
---
<section class="wrap trustbar-wrap" aria-label="Credentials">
  <ul class="trustbar" data-on>
    <li><a class="tb-g" href="/reviews/"><span class="tb-gdot" set:html={g} /><span><b><span class="val">{reviews.rating.toFixed(1)}</span> on Google</b><span class="tb-stars">{[1,2,3,4,5].map(() => <Icon name="fill:star" size={13} />)}<span><span class="odo" data-odo={reviews.total}>{reviews.total}</span> reviews</span></span></span></a></li>
    <li><Icon name="calendar-check" size={22} class="tb-ico" /><span><b><span class="odo val" data-odo={years}>{years}</span> years</b><span>wiring the Valley</span></span></li>
    <li><Icon name="shield-check" size={22} class="tb-ico" /><span><b>Licensed and insured</b><span class="val">{company.roc}</span></span></li>
    <li class="tb-bbb"><BbbSeal /></li>
  </ul>
</section>
<style is:global>
/* Name plates: engraved anodized plates screwed to the page. Engraved Client Plates pattern (21st.dev), rebuilt. */
.trustbar-wrap{position:relative;margin-top:-36px;z-index:2}
.trustbar{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.trustbar>li{position:relative;display:flex;align-items:center;gap:14px;min-width:0;min-height:88px;padding:16px 22px;border-radius:14px;
  background:
    radial-gradient(circle at 10px 10px,#4a515b 0 2px,#15181d 2.6px,transparent 3.4px),
    radial-gradient(circle at calc(100% - 10px) 10px,#4a515b 0 2px,#15181d 2.6px,transparent 3.4px),
    radial-gradient(circle at 10px calc(100% - 10px),#4a515b 0 2px,#15181d 2.6px,transparent 3.4px),
    radial-gradient(circle at calc(100% - 10px) calc(100% - 10px),#4a515b 0 2px,#15181d 2.6px,transparent 3.4px),
    repeating-linear-gradient(90deg,rgba(255,255,255,.012) 0 1px,transparent 1px 3px),
    linear-gradient(180deg,#1d2128,#14171c);
  border:1px solid #070809;box-shadow:inset 0 1px 0 rgba(255,255,255,.07),inset 0 -1px 0 rgba(0,0,0,.5),0 1px 0 rgba(255,255,255,.03)}
.trustbar b{display:flex;align-items:center;gap:.3em;line-height:1.3;font-weight:500;font-size:.9375rem;color:var(--ink);text-shadow:0 -1px 0 rgba(0,0,0,.6)}
.trustbar li span>span{font-size:.8125rem;color:var(--ink-2)}
.trustbar .val{text-shadow:0 -1px 0 rgba(0,0,0,.6)}
.tb-g{display:flex;align-items:center;gap:14px;border-radius:14px}
.tb-gdot{flex:none;width:38px;height:38px;border-radius:50%;background:#fff;display:grid;place-items:center;box-shadow:inset 0 -1px 2px rgba(0,0,0,.25)}
.tb-gdot svg{width:20px;height:20px}
.tb-stars{display:flex;line-height:1.3;margin-top:4px;align-items:center;gap:2px;color:#F4B400}
.tb-stars>span{margin-left:6px;color:var(--ink-2)}
.tb-ico{color:var(--gold)}
.trustbar .bbb{border:0;padding:0}
@media (hover:hover){.tb-g:hover b{color:var(--gold-hi)}}
@media (max-width:980px){.trustbar{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:520px){.trustbar{grid-template-columns:minmax(0,1fr)}.trustbar-wrap{margin-top:0}}
</style>
