---
import { company } from '../data/site';
import reviews from '../data/reviews.json';
import BbbSeal from './BbbSeal.astro';
const years = new Date().getFullYear() - company.since;
const g = '<svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>';
const star = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.8l2.5 5.3 5.8.7-4.3 4 1.1 5.7L10 14.7l-5.1 2.8 1.1-5.7-4.3-4 5.8-.7z" fill="currentColor"/></svg>';
---
<section class="trust" aria-label="Why customers trust Shield">
  <ul class="wrap trust-row">
    <li data-reveal><span class="meter"><span data-meter={years}>{years}</span><small>years</small></span><span class="cap"><b>Wiring the Valley</b>Commercial and residential</span></li>
    <li data-reveal><a class="trust-g" href="/reviews/"><span class="meter"><span class="gdot" set:html={g} />{reviews.rating.toFixed(1)}<span class="stars" set:html={star.repeat(5)} /></span><span class="cap"><b>Google rating</b><span>{reviews.total} reviews <span class="arr" aria-hidden="true">→</span></span></span></a></li>
    <li data-reveal><span class="meter"><span class="shield-ico" aria-hidden="true"><img src="/brand/mark.svg" alt="" width="30" height="36" /></span>ROC</span><span class="cap"><b>Licensed, bonded, insured</b>{company.roc}</span></li>
    <li data-reveal class="trust-bbb"><BbbSeal /><span class="cap"><b>BBB accredited</b>Seal goes live at launch</span></li>
  </ul>
</section>
<style is:global>
.trust{background:var(--switch);border-bottom:1px solid var(--rule-d)}
.trust-row{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
.trust-row>li{display:flex;flex-direction:column;gap:14px;padding:clamp(28px,3vw,40px) clamp(18px,2.2vw,32px);border-left:1px solid var(--rule-d);min-width:0}
.trust-row>li:first-child{border-left:0;padding-left:0}
.trust-g{display:flex;flex-direction:column;gap:14px}
.meter{display:flex;align-items:center;gap:12px;font-family:var(--display);font-weight:600;font-stretch:125%;font-size:clamp(2.25rem,3.6vw,3.25rem);line-height:.9;letter-spacing:-.03em;color:var(--volt);font-variant-numeric:tabular-nums}
.meter small{font-size:.38em;font-weight:500;letter-spacing:0;color:var(--steel);align-self:flex-end;margin-bottom:.2em}
.gdot{flex:none;width:1em;height:1em;border-radius:50%;background:#fff;display:grid;place-items:center}
.gdot svg{width:.56em;height:.56em}
.stars{display:flex;gap:2px;color:#F4B400}
.stars svg{width:15px;height:15px}
.shield-ico img{height:.9em;width:auto}
.cap{display:flex;flex-direction:column;gap:2px;font-size:.875rem;color:var(--steel)}
.cap b{font-size:.9375rem;font-weight:600;color:var(--volt)}
.trust-g .arr{display:inline-block;transition:transform .2s ease-out}
@media (hover:hover){.trust-g:hover .arr{transform:translateX(3px)}.trust-g:hover .cap b{color:var(--brass-lt)}}
@media (max-width:1000px){.trust-row{grid-template-columns:repeat(2,minmax(0,1fr))}.trust-row>li:nth-child(3){border-left:0;padding-left:0}.trust-row>li:nth-child(n+3){border-top:1px solid var(--rule-d)}}
@media (max-width:560px){.trust-row>li{padding:24px 0 24px 16px}.trust-row>li:nth-child(odd){padding-left:0;padding-right:12px}.meter{font-size:2rem}.trust-g .stars{display:none}.bbb{width:100%}}
</style>
