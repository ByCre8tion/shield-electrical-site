---
/* Questions as a numbered ledger: hairlines, no boxes. The open row lights its number and a line
   of current runs under the question. */
interface Props { items: { q: string; a: string }[]; start?: number }
const { items, start = 1 } = Astro.props;
---
<div class="qa" data-on>
  {items.map((f, i) => (
    <details>
      <summary><span class="qa-n val">{String(start + i).padStart(2, '0')}</span><span class="qa-q">{f.q}</span><span class="qa-x" aria-hidden="true"></span><span class="qa-line" aria-hidden="true"></span></summary>
      <p class="ans">{f.a}</p>
    </details>
  ))}
</div>
