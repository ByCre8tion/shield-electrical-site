---
/* Breaker panel: each service is a tile with a switch that throws on hover or focus.
   Cursor spotlight from the Spotlight Card pattern (21st.dev), rebuilt. No photos until real job shots exist. */
import { services } from '../data/site';
import Icon from './Icon.astro';
const icon: Record<string, string> = { commercial: 'buildings', residential: 'house-line', 'panel-upgrades': 'gauge', 'ev-charging': 'plug-charging', 'custom-lighting': 'lightbulb-filament', 'emergency-repairs': 'warning' };
---
<ul class="breakers">
  {services.map((s, i) => (
    <li class:list={['brk', { 'brk-lead': i === 0, 'brk-em': s.emergency }]} data-on>
      <a href={`/services/${s.slug}/`} class="panel" data-spot>
        <span class="brk-top">
          <span class="brk-ico"><Icon name={icon[s.slug]} size={22} /></span>
          <span class="switch" aria-hidden="true"><span></span></span>
        </span>
        <span class="brk-body">
          <h3 class="t-h3">{s.title}</h3>
          <p>{s.short}</p>
          {i === 0 && <ul class="brk-inc">{s.includes.slice(0, 4).map((x) => <li><Icon name="check" size={16} />{x}</li>)}</ul>}
        </span>
        {s.emergency ? <span class="status"><span class="led fault" aria-hidden="true"></span>Call first, any hour</span> : <span class="brk-go">View service <Icon name="arrow-right" size={16} /></span>}
      </a>
    </li>
  ))}
</ul>
<style is:global>
.breakers{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.brk-lead{grid-row:span 2}
.brk-em{grid-column:1 / -1}
.brk a{position:relative;isolation:isolate;overflow:hidden;height:100%;display:flex;flex-direction:column;gap:16px;padding:22px 22px 24px;transition-property:border-color,background-color;transition-duration:.22s;transition-timing-function:var(--snap)}
/* Spotlight follows the pointer inside the tile */
.brk a::before{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(360px circle at var(--mx,50%) var(--my,0%),rgba(242,207,74,.10),transparent 60%);opacity:0;transition:opacity .3s ease-out}
.brk-body{display:flex;flex-direction:column;gap:10px}
.brk-lead .t-h3{font-size:clamp(1.6rem,2.4vw,2.1rem)}
.brk-lead a{gap:22px;padding:28px}
.brk-inc{list-style:none;display:flex;flex-direction:column;gap:10px;margin-top:10px;padding-top:18px;border-top:1px dashed var(--seam-2)}
.brk-inc li{display:flex;gap:10px;align-items:flex-start;font-size:.9375rem;color:var(--ink)}
.brk-inc .ico{color:var(--gold);margin-top:4px}
.brk-em a{flex-direction:row;align-items:center;flex-wrap:wrap;border-color:rgba(255,107,94,.28)}
.brk-em .brk-top{flex-direction:row-reverse;gap:16px}
.brk-em .brk-body{flex:1;min-width:240px}
.brk-em .status{margin-left:auto}
.brk-top{display:flex;justify-content:space-between;align-items:center}
.brk-ico{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:var(--deck-2);border:1px solid var(--seam);color:var(--ink-2);transition-property:color,border-color;transition-duration:.22s;transition-timing-function:var(--snap)}
.switch{position:relative;width:44px;height:24px;border-radius:var(--r-pill);background:var(--deck-2);border:1px solid var(--seam-2);transition-property:background-color,border-color;transition-duration:.22s;transition-timing-function:var(--snap)}
.switch span{position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:var(--ink-3);transition-property:translate,background-color;transition-duration:.22s;transition-timing-function:var(--snap)}
.brk p{color:var(--ink-2);font-size:.9375rem;line-height:1.55}
.brk-go{margin-top:auto;display:inline-flex;align-items:center;gap:8px;font-size:.875rem;color:var(--ink-2);transition:color .2s ease-out}
.brk .status{margin-top:auto}
.brk a:is(:hover,:focus-visible){border-color:rgba(242,207,74,.4)}
.brk a:is(:hover,:focus-visible)::before{opacity:1}
.brk a:is(:hover,:focus-visible) .switch{background:rgba(242,207,74,.18);border-color:var(--gold)}
.brk a:is(:hover,:focus-visible) .switch span{translate:20px 0;background:var(--gold)}
.brk-em a:is(:hover,:focus-visible) .switch span{background:var(--fault)}
.brk-em a:is(:hover,:focus-visible) .switch{border-color:var(--fault);background:rgba(255,107,94,.14)}
.brk a:is(:hover,:focus-visible) .brk-ico{color:var(--gold);border-color:rgba(242,207,74,.4)}
.brk a:is(:hover,:focus-visible) .brk-go{color:var(--gold-hi)}
.brk a:focus-visible{outline:2px solid var(--gold-hi);outline-offset:3px}
@media (max-width:1000px){.breakers{grid-template-columns:repeat(2,minmax(0,1fr))}.brk-lead{grid-row:auto;grid-column:1 / -1}}
@media (max-width:560px){.breakers{grid-template-columns:minmax(0,1fr)}}
</style>
