---
import Circuit from './Circuit.astro';
import Icon from './Icon.astro';
import { company } from '../data/site';
interface Props { title: string; text?: string }
const { title, text } = Astro.props;
---
<section class="wrap sec tight" aria-label={title}>
  <div class="panel ctap" data-on>
    <Circuit density={0.8} />
    <div class="ctap-in">
      <h2 class="t-h2" set:html={title} />
      {text && <p class="lead">{text}</p>}
      <div class="btn-row">
        <a class="btn btn-gold" href="/contact/">Book service <Icon name="arrow-right" size={18} class="ico-go" /></a>
        <a class="btn btn-line" href={`tel:${company.tel}`}><Icon name="phone" size={18} />Call <span class="val">{company.phone}</span></a>
      </div>
    </div>
  </div>
</section>
<style is:global>
.ctap{overflow:hidden;box-shadow:var(--glow)}
.ctap-in{position:relative;display:flex;flex-direction:column;gap:22px;align-items:flex-start;padding:clamp(36px,6vw,88px);max-width:760px;pointer-events:none}
.ctap-in>*{pointer-events:auto}
</style>
