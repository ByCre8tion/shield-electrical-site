---
/* Closing call to action v3: copy over the charged dot field. */
import Icon from './Icon.astro';
import { company } from '../data/site';
interface Props { title: string; text?: string }
const { title, text } = Astro.props;
---
<section class="ctap" aria-label={title.replace(/<[^>]+>/g, '')}>
  <canvas class="ctap-cv" data-field aria-hidden="true"></canvas>
  <div class="wrap ctap-in">
    <p class="hud">Ready when you are</p>
    <h2 class="t-h2" data-on set:html={title} />
    {text && <p class="lead" data-on>{text}</p>}
    <div class="btn-row" data-on>
      <a class="btn btn-gold" href="/contact/">Book service <Icon name="arrow-right" size={18} class="ico-go" /></a>
      <a class="btn btn-line" href={`tel:${company.tel}`}><Icon name="phone" size={18} />Call <span class="val">{company.phone}</span></a>
    </div>
  </div>
</section>
<style is:global>
.ctap{position:relative;overflow:hidden;padding-block:var(--sec) clamp(200px,24vw,340px);border-top:1px solid var(--seam)}
.ctap-cv{position:absolute;left:0;right:0;bottom:0;width:100%;height:70%;pointer-events:none;-webkit-mask:linear-gradient(180deg,transparent,#000 40%);mask:linear-gradient(180deg,transparent,#000 40%)}
.ctap-in{position:relative;display:flex;flex-direction:column;gap:22px;align-items:flex-start}
.ctap-in h2{max-width:18ch}
</style>
