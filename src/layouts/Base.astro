---
import '@fontsource-variable/sora/wght.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Concierge from '../components/Concierge.astro';
import Icon from '../components/Icon.astro';
import { company, services } from '../data/site';
interface Props { title?: string; description?: string; noChat?: boolean }
const { title, description = 'Licensed commercial and residential electricians in Chandler and the Phoenix Valley. Panel upgrades, EV chargers, lighting and repairs, with a written price before work starts.', noChat = false } = Astro.props;
const full = title ? `${title} | Shield Electrical` : 'Shield Electrical | Electricians in Chandler and the Phoenix Valley';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org', '@type': 'Electrician', name: company.name, url: Astro.site?.href, telephone: company.tel, email: company.email,
  image: new URL('/brand/og.jpg', Astro.site).href,
  address: { '@type': 'PostalAddress', streetAddress: company.address, addressLocality: 'Chandler', addressRegion: 'AZ', postalCode: '85224', addressCountry: 'US' },
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '07:00', closes: '17:00' }],
  areaServed: 'Phoenix metropolitan area, Arizona',
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Electrical services', itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.title } })) },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#0B0D10" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/brand/og.jpg', Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <Nav />
  <main id="main">
    <slot />
  </main>
  <Footer />
  {!noChat && <Concierge />}
  <a class="call-bar" href={`tel:${company.tel}`}><Icon name="phone" size={18} />Call <span class="val">{company.phone}</span></a>
  <script>
    import { initSite } from '../scripts/site.js';
    import { initCircuits } from '../scripts/circuit.js';
    import { initChat } from '../scripts/chat.js';
    import { company } from '../data/site';
    initSite(company); initCircuits(); initChat();
  </script>
  <style is:global>
    /* Phones: a tap to call pill, kept clear of the chat button */
    .call-bar{display:none}
    @media (max-width:640px){
      .call-bar{position:fixed;left:16px;bottom:max(16px,env(safe-area-inset-bottom));z-index:55;display:inline-flex;align-items:center;gap:10px;height:56px;padding:0 22px;border-radius:999px;background:linear-gradient(180deg,#F0D49A,#D8B776 48%,#C9A25E);border:1px solid #8E6E37;color:var(--on-gold);font-weight:500;box-shadow:inset 0 1px 0 rgba(255,248,226,.75),0 14px 34px -12px rgba(0,0,0,.8)}
      .menu-open .call-bar{display:none}
      body{padding-bottom:88px}
    }
  </style>
</body>
</html>
