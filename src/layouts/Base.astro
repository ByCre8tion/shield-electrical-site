---
import '@fontsource-variable/sora/wght.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Dispatch from '../components/Dispatch.astro';
import Icon from '../components/Icon.astro';
import { areas, company, services } from '../data/site';
interface Props { title?: string; description?: string; noChat?: boolean; image?: string; ogType?: string; noindex?: boolean }
const { title, description = 'Licensed commercial and residential electricians serving Scottsdale and the Phoenix Valley. Panel upgrades, EV chargers, lighting and repairs, with a written price before work starts.', noChat = false, image, ogType = 'website', noindex = false } = Astro.props;
const ogImg = new URL(image || '/brand/og.jpg?v=3', Astro.site).href;
const full = title ? `${title} | Shield Electrical` : 'Shield Electrical | Electricians in Scottsdale and the Phoenix Valley';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org', '@type': 'Electrician', name: company.name, url: Astro.site?.href, telephone: company.tel, email: company.email,
  image: new URL('/brand/og.jpg', Astro.site).href,
  address: { '@type': 'PostalAddress', streetAddress: company.address, addressLocality: 'Chandler', addressRegion: 'AZ', postalCode: '85224', addressCountry: 'US' },
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '07:00', closes: '17:00' }],
  areaServed: areas.map((a) => ({ '@type': 'City', name: `${a}, AZ` })),
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Electrical services', itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.title } })) },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#0A0A0B" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Shield Electrical" />
  <meta property="og:image" content={ogImg} />
  {!image && <meta property="og:image:width" content="1200" />}
  {!image && <meta property="og:image:height" content="630" />}
  {!image && <meta property="og:image:alt" content="Shield Electrical. Power you can trust, wired right. A wireframe city with one building powered on." />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={full} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImg} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <Nav />
  <main id="main">
    <slot />
  </main>
  <Footer />
  {!noChat && <Dispatch />}
  <script>
    import { initSite } from '../scripts/site.js';
    import { initCircuits } from '../scripts/circuit.js';
    import { initDispatch } from '../scripts/dispatch.js';
    import { initCity } from '../scripts/city.js';
    import { initFields } from '../scripts/field.js';
    import { initGlobes } from '../scripts/globe.js';
    import { initWordmarks } from '../scripts/wordmark.js';
    import { loadPhotos } from '../scripts/photos.js';
    import { company } from '../data/site';
    initSite(company); initCircuits(); initDispatch();
    document.fonts.ready.then(() => { initCity(); initFields(); initGlobes(); initWordmarks(); });
    const heroEl = document.querySelector('.hero');
    if (heroEl) new IntersectionObserver(([e]) => document.documentElement.classList.toggle('in-hero', e.intersectionRatio > .35), { threshold: [0, .35, 1] }).observe(heroEl);
    loadPhotos().finally(() => {
      if (/[?&]edit\b/.test(location.search) || sessionStorage.getItem('shield-edit')) import('../scripts/editor.js').then((m) => { m.startEditor(); if (location.pathname.startsWith('/blog/')) import('../scripts/blog-editor.js').then((b) => b.startBlogEditor()); });
    });
  </script>
  <style is:global>
    /* Phones: room under the footer for the text launcher */
    @media (max-width:640px){
      body{padding-bottom:88px}
    }
  </style>
</body>
</html>
