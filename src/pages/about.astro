---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import TrustBar from '../components/TrustBar.astro';
import CtaPanel from '../components/CtaPanel.astro';
import Socials from '../components/Socials.astro';
import Icon from '../components/Icon.astro';
import { values } from '../data/site';
const vi = ['shield-check', 'file-text', 'wrench'];
---
<Base title="About" description="Shield Electrical is a licensed commercial and residential electrical contractor based in Chandler, Arizona.">
  <PageHead title='Built on precision. Backed by power.' lead="A Chandler electrical contractor for homes and businesses that need it done right." current="About" />
  <TrustBar />
  <section class="sec" aria-labelledby="story-h">
    <div class="wrap split">
      <div data-on><Photo k="crew" ratio="4 / 3" /></div>
      <div class="story">
        <h2 id="story-h" class="t-h2" data-on>An electrician who answers the phone</h2>
        <p class="body" data-on>[Jason's story: how Shield started, the year, the kind of work that built the company and what he wants every customer to feel when the job is done. To be written with Jason.]</p>
        <figure class="sig" data-on><img src="/brand/jason.webp" alt="" width="52" height="52" /><figcaption><b>Jason</b><span>Owner, Shield Electrical</span></figcaption></figure>
        <div data-on><Socials /></div>
      </div>
    </div>
  </section>
  <section class="sec tight" aria-labelledby="val-h">
    <div class="wrap">
      <div class="head"><h2 id="val-h" class="t-h2" data-on>What you can count on</h2></div>
      <div class="vals">
        {values.map((v, i) => <div class:list={['panel', 'val-c', { 'val-big': i === 0 }]} data-on><Icon name={vi[i]} size={28} class="tb-ico" /><h3 class="t-h3">{v.t}</h3><p class="small">{v.d}</p></div>)}
      </div>
    </div>
  </section>
  <CtaPanel title='Work with a crew that shows up.' />
</Base>
<style is:global>
.story{display:flex;flex-direction:column;gap:22px;align-items:flex-start}
.sig{display:flex;align-items:center;gap:14px;margin:0}
.sig img{width:52px;height:52px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 2px var(--gold)}
.sig figcaption{display:flex;flex-direction:column;font-size:.875rem;color:var(--ink-2)}
.sig b{font-weight:500;color:var(--ink);font-size:1rem}
.vals{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);grid-template-rows:auto auto;gap:14px}
.val-c{padding:26px;display:flex;flex-direction:column;gap:12px}
.val-big{grid-row:span 2;justify-content:flex-end;background:radial-gradient(120% 90% at 0% 0%,rgba(242,207,74,.12),transparent 60%),var(--deck)}
.val-big .t-h3{font-size:1.75rem;font-weight:300;letter-spacing:-.02em}
@media (max-width:760px){.vals{grid-template-columns:minmax(0,1fr)}.val-big{grid-row:auto}}
</style>
