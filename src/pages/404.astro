---
import Base from '../layouts/Base.astro';
import Segments from '../components/Segments.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found">
  <section class="wrap nf">
    <Segments value="404" />
    <h1 class="t-h1">This circuit is dead</h1>
    <p class="lead">The link is old or mistyped. Nothing on your end is broken.</p>
    <div class="btn-row"><a class="btn btn-gold" href="/">Back home <Icon name="arrow-right" size={18} class="ico-go" /></a><a class="btn btn-line" href="/services/">See services</a></div>
  </section>
</Base>
<style>
.nf{display:flex;flex-direction:column;align-items:flex-start;gap:28px;padding-block:clamp(64px,10vw,140px)}
</style>
