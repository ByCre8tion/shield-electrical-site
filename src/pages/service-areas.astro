---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Office from '../components/Office.astro';
import GridMap from '../components/GridMap.astro';
import CtaPanel from '../components/CtaPanel.astro';
---
<Base title="Service areas" description="Shield Electrical serves Scottsdale, Paradise Valley, Phoenix, Tempe, Chandler, Gilbert, Mesa, Queen Creek and the rest of the Phoenix Valley.">
  <PageHead title='Scottsdale first. Valley wide.' lead="Focused on Scottsdale and Paradise Valley, working across the greater Phoenix area." current="Service areas" />
  <section class="sec tight gridbg"><div class="wrap"><GridMap /></div></section>
  <section class="sec tight"><div class="wrap"><Office /></div></section>
  <CtaPanel title='Not on the list? Ask anyway.' text="We travel for commercial work and larger residential projects." />
</Base>
