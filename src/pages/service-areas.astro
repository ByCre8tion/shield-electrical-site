---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Areas from '../components/Areas.astro';
import BrassBlock from '../components/BrassBlock.astro';
import { company } from '../data/site';
---
<Base title="Service areas" description="Shield Electrical serves Chandler, Gilbert, Mesa, Tempe, Phoenix, Scottsdale, Queen Creek and the rest of the Phoenix Valley.">
  <PageHead n="04" label="Service areas" title='Chandler based. <span class="hl">Valley wide.</span>' lead={`Our office is at ${company.address}, ${company.city}. We work across the East Valley and the greater Phoenix area.`} crumbs={[]} />
  <section class="sec light"><div class="wrap"><Areas /></div></section>
  <BrassBlock title="Not on the list? Ask anyway." text="We travel for commercial work and larger residential projects." />
</Base>
