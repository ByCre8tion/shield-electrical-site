---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaPanel from '../components/CtaPanel.astro';
import Icon from '../components/Icon.astro';
import { faqGroups } from '../data/site';
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqGroups.flatMap((g) => g.items).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="FAQ" description="Answers about pricing, permits, panel upgrades, EV chargers and licensing from Shield Electrical.">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <PageHead title='Straight answers' lead="The questions we hear most. Ask the assistant in the corner if yours is not here." current="FAQ" />
  <section class="sec tight">
    <div class="wrap faq-wrap">
      {faqGroups.map((g) => (
        <div class="faq-group">
          <h2 class="t-h3" data-on>{g.g}</h2>
          <div class="qa" data-on>{g.items.map((f) => <details><summary>{f.q}<Icon name="caret-down" size={18} /></summary><p class="ans">{f.a}</p></details>)}</div>
        </div>
      ))}
    </div>
  </section>
  <CtaPanel title='Still have a question?' />
</Base>
<style is:global>
.faq-wrap{max-width:880px;display:flex;flex-direction:column;gap:clamp(40px,5vw,64px)}
.faq-group{display:flex;flex-direction:column;gap:18px}
.faq-group>h2{color:var(--ink-2);font-weight:400}
</style>
