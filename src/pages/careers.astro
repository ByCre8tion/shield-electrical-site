---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { roles, perks } from '../data/site';
---
<Base title="Careers" description="Electrician jobs at Shield Electrical, serving Scottsdale and the Phoenix Valley. Journeyman, apprentice and service technician roles.">
  <PageHead title='Build your career with Shield' lead="We are hiring electricians who take pride in clean work and treat customers well." current="Careers">
    <div class="btn-row" data-on><a class="btn btn-gold" href="#apply">Apply now <Icon name="arrow-right" size={18} class="ico-go" /></a></div>
  </PageHead>
  <section class="sec tight" aria-labelledby="roles-h">
    <div class="wrap split-7-5">
      <div class="qa roles" data-on>
        {roles.map((r) => (
          <details>
            <summary><span class="role-t"><span>{r.t}</span><span class="small">{r.type}</span></span><Icon name="caret-down" size={18} /></summary>
            <div class="ans role-b"><p>{r.d}</p><ul class="chips">{r.req.map((q) => <li><Icon name="check" size={16} />{q}</li>)}</ul><a class="btn btn-line" href="#apply" data-role={r.t}>Apply for this role</a></div>
          </details>
        ))}
      </div>
      <div class="head"><h2 id="roles-h" class="t-h2" data-on>Open roles</h2><p class="lead" data-on>Roles and details are being finalized with Jason.</p></div>
    </div>
  </section>
  <section class="sec tight" aria-labelledby="perk-h">
    <div class="wrap split">
      <div data-on><Photo k="crew" ratio="16 / 10" tag="The crew" /></div>
      <div class="story"><h2 id="perk-h" class="t-h2" data-on>What you get</h2><ul class="chips" data-on>{perks.map((p) => <li><Icon name="check" size={16} />{p}</li>)}</ul></div>
    </div>
  </section>
  <section class="sec" id="apply" aria-labelledby="apply-h">
    <div class="wrap split-7-5">
      <div class="qf wo">
        <div class="wo-head"><span class="wo-title">Application</span><span class="wo-meta val"><span data-today>New application</span></span></div>
        <form class="qf-form" data-form data-endpoint="" novalidate enctype="multipart/form-data">
          <fieldset class="wo-part">
            <legend><span class="val">01</span>You</legend>
            <div class="qf-row">
              <div class="field"><label for="ap-name">Full name</label><input class="input" id="ap-name" name="name" autocomplete="name" required data-msg="Add your name." aria-describedby="ap-name-err" /><span class="err" id="ap-name-err"></span></div>
              <div class="field"><label for="ap-phone">Mobile number</label><input class="input" id="ap-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required data-msg="Add a 10 digit number." aria-describedby="ap-phone-err" /><span class="err" id="ap-phone-err"></span></div>
            </div>
            <div class="field"><label for="ap-email">Email</label><input class="input" id="ap-email" name="email" type="email" autocomplete="email" spellcheck="false" required data-msg="Add an email we can reach you at." aria-describedby="ap-email-err" /><span class="err" id="ap-email-err"></span></div>
          </fieldset>
          <fieldset class="wo-part">
            <legend><span class="val">02</span>The role</legend>
            <div class="wo-keys" role="radiogroup" aria-label="Role" aria-describedby="ap-role-err">
              {[...roles.map((r) => r.t), 'Other'].map((t, i) => <label><input type="radio" name="role" value={t} id={i === 0 ? 'ap-role' : undefined} required data-msg={i === 0 ? 'Choose a role.' : undefined} /><span><i></i>{t}</span></label>)}
            </div>
            <span class="err" id="ap-role-err"></span>
            <span class="fl">Years of experience</span>
            <div class="wo-keys" role="radiogroup" aria-label="Years of experience" aria-describedby="ap-exp-err">
              {['Less than 1', '1 to 3', '4 to 7', '8 or more'].map((t, i) => <label><input type="radio" name="experience" value={t} id={i === 0 ? 'ap-exp' : undefined} required data-msg={i === 0 ? 'Choose your experience.' : undefined} /><span><i></i>{t}</span></label>)}
            </div>
            <span class="err" id="ap-exp-err"></span>
          </fieldset>
          <fieldset class="wo-part">
            <legend><span class="val">03</span>About you</legend>
            <div class="field"><label for="ap-msg">Tell us about yourself <span class="opt">optional</span></label><textarea class="input" id="ap-msg" name="message" rows="3" placeholder="Licenses, the work you like, where you have worked"></textarea></div>
            <div class="field"><label class="drop" for="ap-file"><Icon name="file-text" size={20} /><span><b>Attach a resume</b> PDF or Word, up to 10 MB <span class="opt">optional</span></span></label><input class="sr-only" id="ap-file" name="resume" type="file" accept=".pdf,.doc,.docx" aria-describedby="ap-file-list" /><span class="hint" id="ap-file-list" aria-live="polite"></span></div>
          </fieldset>
          <p class="err" data-form-err role="alert"></p>
          <div class="qf-submit">
            <button class="btn btn-gold" type="submit"><span data-btn-label>Send application</span> <Icon name="arrow-right" size={18} class="ico-go" /></button>
            <p class="wo-note">We read every application and reply within a week.</p>
          </div>
        </form>
        <div class="qf-done" data-done hidden tabindex="-1"><span class="qf-tick" aria-hidden="true"><Icon name="check" size={26} /></span><h3 class="t-h3">Application sent</h3><p>Thanks. We will reach out within a week.</p></div>
      </div>
      <div class="book-side"><h2 id="apply-h" class="t-h2" data-on>Apply in two minutes</h2><p class="lead" data-on>We read every application and reply within a week.</p></div>
    </div>
  </section>
</Base>
<script>
  document.querySelectorAll('[data-role]').forEach((a) => a.addEventListener('click', () => { const s = document.getElementById('ap-role'); if (s) s.value = a.dataset.role; }));
</script>
<style is:global>
.role-t{display:flex;flex-direction:column;gap:2px}
.role-b{display:flex;flex-direction:column;gap:16px;align-items:flex-start}
.book-side{display:flex;flex-direction:column;gap:22px;position:sticky;top:104px}
.story{display:flex;flex-direction:column;gap:22px;align-items:flex-start}
@media (max-width:900px){.book-side{position:static;order:-1}.roles{order:1}}
</style>
