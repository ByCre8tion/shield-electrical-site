---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import { roles, perks } from '../data/site';
---
<Base title="Careers" description="Electrician jobs at Shield Electrical in Chandler, Arizona. Journeyman, apprentice and service technician roles.">
  <PageHead n="07" label="Careers" title='Build your career <span class="hl">with Shield</span>' lead="We are hiring electricians who take pride in clean work and treat customers well." crumbs={[]}>
    <div class="hero-cta" data-reveal><a class="btn btn-brass" href="#apply">Apply now <span class="arr" aria-hidden="true">→</span></a></div>
  </PageHead>
  <section class="sec light" aria-labelledby="roles-h">
    <div class="wrap">
      <div class="sec-head"><p class="readout">01 / <b>Open roles</b></p><div><h2 id="roles-h" class="t-h2">Open roles</h2><p class="lead">Roles and details are being finalized with Jason.</p></div></div>
      <ul class="roles">
        {roles.map((r) => (
          <li data-reveal>
            <div><span class="readout">{r.type}</span><h3 class="t-h3">{r.t}</h3></div>
            <p>{r.d}</p>
            <ul class="inc">{r.req.map((q) => <li>{q}</li>)}</ul>
            <a class="btn btn-line" href="#apply" data-role={r.t}>Apply for this role</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="sec" aria-labelledby="perk-h">
    <div class="wrap why">
      <div data-reveal><Photo k="crew" ratio="16 / 10" /></div>
      <div class="why-copy">
        <p class="readout">02 / <b>Why Shield</b></p>
        <h2 id="perk-h" class="t-h2">What you get</h2>
        <ul class="inc" style="width:100%">{perks.map((p) => <li>{p}</li>)}</ul>
      </div>
    </div>
  </section>
  <section class="sec panel-mode" id="apply" aria-labelledby="apply-h">
    <div class="wrap q-grid">
      <div class="q-copy"><p class="readout">03 / <b>Apply</b></p><h2 id="apply-h" class="t-h2">Apply in two minutes</h2><p class="lead">We read every application and reply within a week.</p></div>
      <div class="qf">
        <form class="qf-form" data-form data-endpoint="" novalidate enctype="multipart/form-data">
          <p class="hint">All fields are required unless marked optional.</p>
          <div class="qf-row">
            <div class="field"><label for="ap-name">Full name</label><input class="input" id="ap-name" name="name" autocomplete="name" required data-msg="Add your name." aria-describedby="ap-name-err" /><span class="err" id="ap-name-err"></span></div>
            <div class="field"><label for="ap-phone">Mobile number</label><input class="input" id="ap-phone" name="phone" type="tel" autocomplete="tel" required data-msg="Add a 10 digit number." aria-describedby="ap-phone-err" /><span class="err" id="ap-phone-err"></span></div>
          </div>
          <div class="qf-row">
            <div class="field"><label for="ap-email">Email</label><input class="input" id="ap-email" name="email" type="email" autocomplete="email" required data-msg="Add an email we can reach you at." aria-describedby="ap-email-err" /><span class="err" id="ap-email-err"></span></div>
            <div class="field"><label for="ap-role">Role</label><select class="input" id="ap-role" name="role" required data-msg="Choose a role." aria-describedby="ap-role-err"><option value="">Choose one</option>{roles.map((r) => <option>{r.t}</option>)}<option>Other</option></select><span class="err" id="ap-role-err"></span></div>
          </div>
          <div class="field"><label for="ap-exp">Years of experience</label><select class="input" id="ap-exp" name="experience" required data-msg="Choose your experience." aria-describedby="ap-exp-err"><option value="">Choose one</option><option>Less than 1</option><option>1 to 3</option><option>4 to 7</option><option>8 or more</option></select><span class="err" id="ap-exp-err"></span></div>
          <div class="field"><label for="ap-msg">Tell us about yourself <span class="opt">(optional)</span></label><textarea class="input" id="ap-msg" name="message"></textarea></div>
          <div class="field"><span class="fl">Resume <span class="opt">(optional)</span></span><label class="drop" for="ap-file"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.5h7.5L19 8v12.5H7z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M14 3.5V8.5h5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><span><b>Attach a resume</b><br />PDF or Word, up to 10 MB.</span></label><input class="sr-only" id="ap-file" name="resume" type="file" accept=".pdf,.doc,.docx" aria-describedby="ap-file-list" /><span class="hint" id="ap-file-list" aria-live="polite"></span></div>
          <p class="err" data-form-err role="alert"></p>
          <button class="btn btn-brass" type="submit" style="align-self:flex-start">Send application</button>
        </form>
        <div class="qf-done" data-done hidden tabindex="-1"><span class="qf-tick" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/></svg></span><h3 class="t-h3">Application sent</h3><p>Thanks. We will reach out within a week.</p></div>
      </div>
    </div>
  </section>
</Base>
<script>
  document.querySelectorAll('[data-role]').forEach((a) => a.addEventListener('click', () => { const s = document.getElementById('ap-role'); if (s) s.value = a.dataset.role; }));
</script>
<style is:global>
.roles{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(20px,3vw,40px)}
.roles>li{display:flex;flex-direction:column;gap:18px;padding-top:24px;border-top:2px solid var(--ink)}
.roles>li>p{color:var(--fg-2)}
.roles .btn{align-self:flex-start;margin-top:auto}
.field:has(#ap-file:focus-visible) .drop{outline:2px solid var(--brass-deep);outline-offset:2px}
@media (max-width:900px){.roles{grid-template-columns:minmax(0,1fr)}}
</style>
