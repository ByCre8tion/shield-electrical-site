---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import BrassBlock from '../components/BrassBlock.astro';
import { projects } from '../data/site';
const cats = ['All', ...new Set(projects.map((p) => p.scope))];
---
<Base title="Projects" description="Recent commercial and residential electrical projects by Shield Electrical across the Phoenix Valley.">
  <PageHead n="02" label="Projects" title='Recent <span class="hl">work</span>' lead="Panels, lighting, EV chargers and commercial build outs across the Valley." crumbs={[]} />
  <section class="sec light" aria-label="Project list">
    <div class="wrap">
      <p class="note-ph">Layout examples. Real Shield projects and photos replace these before launch.</p>
      <div class="filters" role="group" aria-label="Filter projects">
        {cats.map((c, i) => <button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={c}>{c}</button>)}
      </div>
      <ul class="proj">
        {projects.map((p) => (
          <li data-cat={p.scope} data-reveal>
            <Photo k={p.img} ratio="4 / 3" sizes="(max-width: 860px) 100vw, 33vw" />
            <div class="proj-meta"><span class="readout">{p.scope} · {p.city}</span><h2 class="t-h3">{p.title}</h2><p class="num">{p.spec}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <BrassBlock title="Have a project like these?" text="Send the plans or a few photos and we will price it." cta="Start a project" />
</Base>
<script>
  const chips = [...document.querySelectorAll('[data-filter]')], items = [...document.querySelectorAll('.proj li')];
  chips.forEach((c) => c.addEventListener('click', () => {
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    items.forEach((i) => { i.hidden = c.dataset.filter !== 'All' && i.dataset.cat !== c.dataset.filter; });
  }));
</script>
<style is:global>
.note-ph{font-family:var(--mono);font-size:.75rem;letter-spacing:.04em;color:var(--muted);margin-bottom:24px}
.filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:clamp(28px,4vw,48px)}
.chip{min-height:40px;padding:0 16px;border:1px solid var(--rule-strong);border-radius:2px;font-size:.9375rem;font-weight:500;color:var(--fg-2);transition:background-color .15s ease-out,color .15s ease-out,border-color .15s ease-out}
.chip[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:var(--paper)}
@media (hover:hover){.chip:hover{border-color:var(--fg)}}
.proj{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(28px,3vw,40px) clamp(16px,2vw,28px)}
.proj li[hidden]{display:none}
.proj-meta{display:flex;flex-direction:column;gap:8px;padding-top:16px}
.proj-meta p{color:var(--fg-2);font-size:.9375rem}
@media (max-width:900px){.proj{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:560px){.proj{grid-template-columns:minmax(0,1fr)}}
</style>
