---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Directory from '../components/Directory.astro';
import PowerPath from '../components/PowerPath.astro';
import PanelCheck from '../components/PanelCheck.astro';
import Coverage from '../components/Coverage.astro';
import Reviews from '../components/Reviews.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FieldGallery from '../components/FieldGallery.astro';
import CtaPanel from '../components/CtaPanel.astro';
import Icon from '../components/Icon.astro';
import JobTracker from '../components/JobTracker.astro';
import FaqSection from '../components/FaqSection.astro';
---
<Base>
  <Hero />
  <TrustBar />

  <section class="sec" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="head svc-head"><h2 id="svc-h" class="t-h2" data-on>One crew for every circuit</h2></div>
      <Directory />
      <div class="svc-more"><a class="btn btn-line" href="/services/">Every service in detail <Icon name="arrow-right" size={18} class="ico-go" /></a></div>
    </div>
  </section>

  <FieldGallery />

  <PowerPath />

  <section class="sec charged" aria-labelledby="pc-h">
    <canvas class="charged-cv" data-field aria-hidden="true"></canvas>
    <div class="wrap charged-in">
      <div class="head"><h2 id="pc-h" class="t-h2" data-on>Is your panel ready for more?</h2><p class="lead" data-on>Three questions. A quick read on whether your panel can take a charger, spa or casita.</p></div>
      <div data-on><PanelCheck /></div>
    </div>
  </section>

  <Coverage />

  <Reviews />

  <FaqSection />

  <section class="sec" id="book" aria-labelledby="book-h">
    <div class="wrap split-7-5">
      <div data-on><QuoteForm /></div>
      <div class="book-side">
        <h2 id="book-h" class="t-h2" data-on>Tell us what is going on</h2>
        <p class="lead" data-on>Send the details and a photo if you have one. We reply within one business day.</p>
        <JobTracker />
      </div>
    </div>
  </section>
</Base>
<style is:global>
.svc-more{display:flex;justify-content:center;margin-top:32px}
.charged{position:relative;overflow:hidden;padding-bottom:clamp(220px,26vw,380px)}
.charged-cv{position:absolute;left:0;right:0;bottom:0;width:100%;height:62%;pointer-events:none;-webkit-mask:linear-gradient(180deg,transparent,#000 35%);mask:linear-gradient(180deg,transparent,#000 35%)}
.charged-in{position:relative}
.charged .pc{background:rgba(18,19,20,.82);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
.book-side{display:flex;flex-direction:column;gap:22px;position:sticky;top:104px}
@media (max-width:900px){.book-side{position:static;order:-1}}
</style>
