---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import PanelCheck from '../components/PanelCheck.astro';
import Process from '../components/Process.astro';
import Reviews from '../components/Reviews.astro';
import Office from '../components/Office.astro';
import QuoteForm from '../components/QuoteForm.astro';
import CtaPanel from '../components/CtaPanel.astro';
import SlideLink from '../components/SlideLink.astro';
import JobTracker from '../components/JobTracker.astro';
---
<Base>
  <Hero />
  <TrustBar />

  <section class="sec" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="head"><h2 id="svc-h" class="t-h2" data-on>One crew for every circuit</h2><p class="lead" data-on>Homes, offices, chargers and emergencies. Pick a service, or describe the problem and we will sort it out.</p></div>
      <ServiceGrid />
      <div class="more"><SlideLink href="/services/" text="Every service in detail" /></div>
    </div>
  </section>

  <section class="sec tight" aria-labelledby="pc-h">
    <div class="wrap">
      <div class="head"><h2 id="pc-h" class="t-h2" data-on>Is your panel ready for more?</h2><p class="lead" data-on>Answer three questions for a quick read on whether your panel can take a charger, spa or casita.</p></div>
      <div data-on><PanelCheck /></div>
    </div>
  </section>

  <section class="sec" aria-labelledby="proc-h">
    <div class="wrap split-7-5 proc-wrap">
      <div>
        <div class="head"><h2 id="proc-h" class="t-h2" data-on>From call to inspected</h2></div>
        <Process />
      </div>
    </div>
  </section>

  <Reviews />

  <section class="sec tight" aria-labelledby="area-h">
    <div class="wrap">
      <div class="head"><h2 id="area-h" class="t-h2" data-on>Based in Chandler, working Valley wide</h2></div>
      <Office />
      <div class="more"><SlideLink href="/service-areas/" text="All the cities we cover" /></div>
    </div>
  </section>

  <section class="sec" id="book" aria-labelledby="book-h">
    <div class="wrap split-7-5">
      <div data-on><QuoteForm /></div>
      <div class="book-side">
        <h2 id="book-h" class="t-h2" data-on>Tell us what is going on</h2>
        <p class="lead" data-on>Send the details and a photo if you have one. We reply within one business day.</p>
        <JobTracker />
      </div>
    </div>
  </section>

  <CtaPanel title='Need power where you do not have it?' text="Outlets, circuits, chargers or a whole new service. One call gets it planned." />
</Base>
<style is:global>
.more{margin-top:24px}
.proc-wrap{grid-template-columns:minmax(0,1fr);gap:clamp(40px,6vw,72px)}
.proc-photo{max-height:420px;overflow:hidden;border-radius:20px}

.book-side{display:flex;flex-direction:column;gap:22px;position:sticky;top:104px}
@media (max-width:900px){.book-side{position:static;order:-1}.proc-photo{display:none}}
</style>
