---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import PanelCheck from '../components/PanelCheck.astro';
import Process from '../components/Process.astro';
import Reviews from '../components/Reviews.astro';
import Office from '../components/Office.astro';
import QuoteForm from '../components/QuoteForm.astro';
import CtaPanel from '../components/CtaPanel.astro';
import Photo from '../components/Photo.astro';
---
<Base>
  <Hero />
  <TrustBar />

  <section class="sec" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="head"><h2 id="svc-h" class="t-h2" data-on>One crew for every <span class="hl">circuit</span></h2><p class="lead" data-on>Homes, offices, chargers and emergencies. Pick a service, or describe the problem and we will sort it out.</p></div>
      <ServiceGrid />
    </div>
  </section>

  <section class="sec tight" aria-labelledby="pc-h">
    <div class="wrap">
      <div class="head"><h2 id="pc-h" class="t-h2" data-on>Is your panel ready for <span class="hl">more</span>?</h2><p class="lead" data-on>Answer three questions for a quick read on whether your panel can take a charger, spa or casita.</p></div>
      <div data-on><PanelCheck /></div>
    </div>
  </section>

  <section class="sec" aria-labelledby="proc-h">
    <div class="wrap split-7-5 proc-wrap">
      <div>
        <div class="head"><h2 id="proc-h" class="t-h2" data-on>From call to <span class="hl">inspected</span></h2><p class="lead" data-on>Every job runs the same four steps, so you always know what happens next.</p></div>
        <Process />
      </div>
      <div class="proc-photo" data-on><Photo k="tools" ratio="21 / 8" sizes="100vw" /></div>
    </div>
  </section>

  <Reviews />

  <section class="sec tight" aria-labelledby="area-h">
    <div class="wrap">
      <div class="head"><h2 id="area-h" class="t-h2" data-on>Based in Chandler, working <span class="hl">Valley wide</span></h2></div>
      <Office />
    </div>
  </section>

  <section class="sec" id="book" aria-labelledby="book-h">
    <div class="wrap split-7-5">
      <div data-on><QuoteForm /></div>
      <div class="book-side">
        <h2 id="book-h" class="t-h2" data-on>Tell us what is <span class="hl">going on</span></h2>
        <p class="lead" data-on>Send the details and a photo if you have one. We reply within one business day with next steps and a price range.</p>
        <div data-on><Photo k="copper" ratio="16 / 10" sizes="(max-width: 900px) 100vw, 35vw" /></div>
      </div>
    </div>
  </section>

  <CtaPanel title='Need power where you <span class="hl">do not</span> have it?' text="Outlets, circuits, chargers or a whole new service. One call gets it planned." />
</Base>
<style is:global>
.proc-wrap{grid-template-columns:minmax(0,1fr);gap:clamp(40px,6vw,72px)}
.proc-photo{max-height:420px;overflow:hidden;border-radius:20px}

.book-side{display:flex;flex-direction:column;gap:22px;position:sticky;top:104px}
@media (max-width:900px){.book-side{position:static;order:-1}.proc-photo{display:none}}
</style>
